---
interface GalleryImage {
  id: string;
  src: string;
  alt: string;
  caption?: string;
  width: number;
  height: number;
}

interface Props {
  images: GalleryImage[];
  batchSize?: number;
}

const { images, batchSize = 12 } = Astro.props;

const initialImages = images.slice(0, batchSize);
---

<div class="masonry-gallery" data-batch-size={batchSize}>
  <div class="masonry-container">
    {initialImages.map((image) => (
      <div class="masonry-item" data-id={image.id}>
        <img
          src={image.src}
          alt={image.alt}
          width={image.width}
          height={image.height}
          loading="lazy"
          decoding="async"
          class="masonry-img"
        />
        {image.caption && (
          <div class="masonry-caption">{image.caption}</div>
        )}
      </div>
    ))}
  </div>

  {images.length > batchSize && (
    <div class="load-more-sentinel" aria-hidden="true"></div>
  )}

  <div class="loading-indicator hidden">
    <div class="loading-spinner"></div>
  </div>
</div>

<!-- Store remaining images as JSON for infinite scroll -->
<script define:vars={{ allImages: images, batchSize }}>
  window.__galleryData = {
    images: allImages,
    batchSize: batchSize,
    loadedCount: Math.min(batchSize, allImages.length)
  };
</script>

<script>
  function initMasonryGallery() {
    const gallery = document.querySelector('.masonry-gallery');
    if (!gallery) return;

    const container = gallery.querySelector('.masonry-container');
    const sentinel = gallery.querySelector('.load-more-sentinel');
    const loadingIndicator = gallery.querySelector('.loading-indicator');

    const data = (window as any).__galleryData;
    if (!data) return;

    let isLoading = false;

    const loadMoreImages = () => {
      if (isLoading || data.loadedCount >= data.images.length) return;

      isLoading = true;
      loadingIndicator?.classList.remove('hidden');

      const nextBatch = data.images.slice(
        data.loadedCount,
        data.loadedCount + data.batchSize
      );

      // Simulate slight delay for smooth UX
      setTimeout(() => {
        nextBatch.forEach((image: any) => {
          const item = document.createElement('div');
          item.className = 'masonry-item';
          item.dataset.id = image.id;

          const img = document.createElement('img');
          img.src = image.src;
          img.alt = image.alt;
          img.width = image.width;
          img.height = image.height;
          img.loading = 'lazy';
          img.decoding = 'async';
          img.className = 'masonry-img';

          item.appendChild(img);

          if (image.caption) {
            const caption = document.createElement('div');
            caption.className = 'masonry-caption';
            caption.textContent = image.caption;
            item.appendChild(caption);
          }

          container?.appendChild(item);
        });

        data.loadedCount += nextBatch.length;
        isLoading = false;
        loadingIndicator?.classList.add('hidden');

        // Remove sentinel if no more images
        if (data.loadedCount >= data.images.length) {
          sentinel?.remove();
        }
      }, 100);
    };

    // Intersection Observer for infinite scroll
    if (sentinel) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries[0].isIntersecting) {
            loadMoreImages();
          }
        },
        { rootMargin: '200px' }
      );
      observer.observe(sentinel);
    }

    // Lightbox functionality
    container?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const img = target.closest('.masonry-img') as HTMLImageElement;
      if (!img) return;

      const lightbox = document.createElement('div');
      lightbox.className = 'lightbox';
      lightbox.innerHTML = `
        <div class="lightbox-backdrop"></div>
        <div class="lightbox-content">
          <img src="${img.src}" alt="${img.alt}" />
          <button class="lightbox-close" aria-label="Close">&times;</button>
        </div>
      `;

      document.body.appendChild(lightbox);
      document.body.style.overflow = 'hidden';

      // Animate in
      requestAnimationFrame(() => {
        lightbox.classList.add('active');
      });

      const closeLightbox = () => {
        lightbox.classList.remove('active');
        setTimeout(() => {
          lightbox.remove();
          document.body.style.overflow = '';
        }, 200);
      };

      lightbox.querySelector('.lightbox-backdrop')?.addEventListener('click', closeLightbox);
      lightbox.querySelector('.lightbox-close')?.addEventListener('click', closeLightbox);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeLightbox();
      }, { once: true });
    });
  }

  // Run on page load and after navigation
  initMasonryGallery();
  document.addEventListener('astro:after-swap', initMasonryGallery);
</script>

<style>
  .masonry-gallery {
    width: 100%;
  }

  .masonry-container {
    column-count: 2;
    column-gap: 1rem;
  }

  @media (min-width: 640px) {
    .masonry-container {
      column-count: 3;
    }
  }

  @media (min-width: 1024px) {
    .masonry-container {
      column-count: 4;
    }
  }

  .masonry-item {
    position: relative;
    break-inside: avoid;
    margin-bottom: 1rem;
    border-radius: 0.5rem;
    overflow: hidden;
    background: rgb(30 41 59 / 0.5);
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .masonry-item:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgb(0 0 0 / 0.3);
  }

  .masonry-img {
    width: 100%;
    height: auto;
    display: block;
  }

  .masonry-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0.75rem;
    font-size: 0.875rem;
    color: rgb(226 232 240);
    background: linear-gradient(transparent, rgb(0 0 0 / 0.8));
    opacity: 0;
    transform: translateY(100%);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .masonry-item:hover .masonry-caption {
    opacity: 1;
    transform: translateY(0);
  }

  .load-more-sentinel {
    height: 1px;
    width: 100%;
  }

  .loading-indicator {
    display: flex;
    justify-content: center;
    padding: 2rem;
  }

  .loading-indicator.hidden {
    display: none;
  }

  .loading-spinner {
    width: 2rem;
    height: 2rem;
    border: 2px solid rgb(51 65 85);
    border-top-color: rgb(34 211 238);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Lightbox styles */
  :global(.lightbox) {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  :global(.lightbox.active) {
    opacity: 1;
  }

  :global(.lightbox-backdrop) {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.9);
  }

  :global(.lightbox-content) {
    position: relative;
    max-width: 90vw;
    max-height: 90vh;
  }

  :global(.lightbox-content img) {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 0.5rem;
  }

  :global(.lightbox-close) {
    position: absolute;
    top: -2.5rem;
    right: 0;
    background: none;
    border: none;
    color: white;
    font-size: 2rem;
    cursor: pointer;
    padding: 0.5rem;
    line-height: 1;
  }

  :global(.lightbox-close:hover) {
    color: rgb(34 211 238);
  }
</style>
