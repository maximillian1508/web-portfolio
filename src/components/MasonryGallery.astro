---
interface GalleryImage {
  id: string;
  src: string;
  alt: string;
  caption?: string;
  width: number;
  height: number;
}

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;
---

<div class="masonry-gallery">
  <div class="masonry-container">
    {images.map((image) => (
      <div class="masonry-item" data-id={image.id}>
        <img
          src={image.src}
          alt={image.alt}
          width={image.width}
          height={image.height}
          loading="lazy"
          decoding="async"
          class="masonry-img"
        />
        {image.caption && (
          <div class="masonry-caption">{image.caption}</div>
        )}
      </div>
    ))}
  </div>
</div>

<script>
  function initMasonryGallery() {
    const gallery = document.querySelector('.masonry-gallery');
    if (!gallery) return;

    const container = gallery.querySelector('.masonry-container');

    // Lightbox functionality
    container?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const img = target.closest('.masonry-img') as HTMLImageElement;
      if (!img) return;

      const lightbox = document.createElement('div');
      lightbox.className = 'lightbox';
      lightbox.innerHTML = `
        <div class="lightbox-backdrop"></div>
        <div class="lightbox-content">
          <img src="${img.src}" alt="${img.alt}" />
          <button class="lightbox-close" aria-label="Close">&times;</button>
        </div>
      `;

      document.body.appendChild(lightbox);
      document.body.style.overflow = 'hidden';

      // Animate in
      requestAnimationFrame(() => {
        lightbox.classList.add('active');
      });

      const closeLightbox = () => {
        lightbox.classList.remove('active');
        setTimeout(() => {
          lightbox.remove();
          document.body.style.overflow = '';
        }, 200);
      };

      lightbox.querySelector('.lightbox-backdrop')?.addEventListener('click', closeLightbox);
      lightbox.querySelector('.lightbox-close')?.addEventListener('click', closeLightbox);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeLightbox();
      }, { once: true });
    });
  }

  // Run on page load and after navigation
  initMasonryGallery();
  document.addEventListener('astro:after-swap', initMasonryGallery);
</script>

<style>
  .masonry-gallery {
    width: 100%;
  }

  .masonry-container {
    column-count: 2;
    column-gap: 1rem;
  }

  @media (min-width: 640px) {
    .masonry-container {
      column-count: 3;
    }
  }

  @media (min-width: 1024px) {
    .masonry-container {
      column-count: 4;
    }
  }

  .masonry-item {
    position: relative;
    break-inside: avoid;
    margin-bottom: 1rem;
    border-radius: 0.5rem;
    overflow: hidden;
    background: rgb(30 41 59 / 0.5);
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .masonry-item:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgb(0 0 0 / 0.3);
  }

  .masonry-img {
    width: 100%;
    height: auto;
    display: block;
  }

  .masonry-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0.75rem;
    font-size: 0.875rem;
    color: rgb(226 232 240);
    background: linear-gradient(transparent, rgb(0 0 0 / 0.8));
    opacity: 0;
    transform: translateY(100%);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .masonry-item:hover .masonry-caption {
    opacity: 1;
    transform: translateY(0);
  }

  .load-more-sentinel {
    height: 1px;
    width: 100%;
  }

  .loading-indicator {
    display: flex;
    justify-content: center;
    padding: 2rem;
  }

  .loading-indicator.hidden {
    display: none;
  }

  .loading-spinner {
    width: 2rem;
    height: 2rem;
    border: 2px solid rgb(51 65 85);
    border-top-color: rgb(34 211 238);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Lightbox styles */
  :global(.lightbox) {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  :global(.lightbox.active) {
    opacity: 1;
  }

  :global(.lightbox-backdrop) {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.9);
  }

  :global(.lightbox-content) {
    position: relative;
    max-width: 90vw;
    max-height: 90vh;
  }

  :global(.lightbox-content img) {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 0.5rem;
  }

  :global(.lightbox-close) {
    position: absolute;
    top: -2.5rem;
    right: 0;
    background: none;
    border: none;
    color: white;
    font-size: 2rem;
    cursor: pointer;
    padding: 0.5rem;
    line-height: 1;
  }

  :global(.lightbox-close:hover) {
    color: rgb(34 211 238);
  }
</style>
