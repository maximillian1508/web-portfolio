---
import { pageMap } from "@lib/pageMap";
import {
  getLangFromUrl,
  useTranslations,
  getLocalelessPath,
  getLocaleUrl,
} from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const localelessPath = getLocalelessPath(Astro.url.pathname, lang);
const currentPage =
  pageMap[localelessPath as keyof typeof pageMap] || pageMap["/"];
const totalPages = Object.keys(pageMap).length;
---

<header
  class="fixed top-0 left-0 right-0 z-50 bg-slate-950/90 backdrop-blur-sm border-b border-slate-800"
>
  <div class="max-w-[1280px] mx-auto px-4 md:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <div class="flex items-center gap-8">
        <a
          href={getLocaleUrl(lang, "/")}
          class="text-slate-400 font-mono text-sm hover:text-cyan-400 transition-colors"
        >
          ML.portfolio
        </a>
        <div class="hidden md:flex items-center gap-4 text-xs font-mono">
          {
            Object.entries(pageMap).map(([path, page], index) => (
              <div class="flex items-center gap-4">
                <a
                  href={getLocaleUrl(lang, path)}
                  class={`transition-colors ${
                    localelessPath === path
                      ? "text-purple-400"
                      : "text-slate-400 hover:text-cyan-400"
                  }`}
                >
                  {t(page.nameKey)}
                </a>
                {index < Object.keys(pageMap).length - 1 && (
                  <span class="text-slate-600">•</span>
                )}
              </div>
            ))
          }
        </div>
      </div>

      <div class="hidden md:block text-slate-400 font-mono text-sm">
        <span class="text-purple-400">
          {t("common.page")}
          {currentPage.number}
          {t("common.of")}
          {totalPages}
        </span>
      </div>

      <button
        id="mobile-menu-button"
        class="md:hidden flex flex-col gap-1 p-2"
        aria-label="Toggle menu"
      >
        <span id="menu-line-1" class="w-5 h-0.5 bg-slate-300 transition-all"
        ></span>
        <span id="menu-line-2" class="w-5 h-0.5 bg-slate-300 transition-all"
        ></span>
        <span id="menu-line-3" class="w-5 h-0.5 bg-slate-300 transition-all"
        ></span>
      </button>
    </div>

    <nav
      id="mobile-menu"
      class="md:hidden border-t border-slate-800 py-4 hidden"
    >
      <div class="flex flex-col gap-4 text-sm">
        {
          Object.entries(pageMap).map(([path, page]) => (
            <a
              href={getLocaleUrl(lang, path)}
              class={`transition-colors py-2 mobile-menu-link ${
                localelessPath === path
                  ? "text-purple-400"
                  : "text-slate-300 hover:text-cyan-400"
              }`}
            >
              {t(page.nameKey)}
            </a>
          ))
        }
        <div
          class="text-slate-400 font-mono text-xs pt-2 border-t border-slate-800"
        >
          {t("common.page")}
          {currentPage.number}
          {t("common.of")}
          {totalPages}
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const mobileMenuButton = document.getElementById("mobile-menu-button");
    const mobileMenu = document.getElementById("mobile-menu");
    const menuLine1 = document.getElementById("menu-line-1");
    const menuLine2 = document.getElementById("menu-line-2");
    const menuLine3 = document.getElementById("menu-line-3");
    const mobileMenuLinks = document.querySelectorAll(".mobile-menu-link");
    let isMenuOpen = false;

    function toggleMenu() {
      isMenuOpen = !isMenuOpen;

      if (isMenuOpen) {
        mobileMenu?.classList.remove("hidden");
        menuLine1?.classList.add("rotate-45", "translate-y-1.5");
        menuLine2?.classList.add("opacity-0");
        menuLine3?.classList.add("-rotate-45", "-translate-y-1.5");
      } else {
        mobileMenu?.classList.add("hidden");
        menuLine1?.classList.remove("rotate-45", "translate-y-1.5");
        menuLine2?.classList.remove("opacity-0");
        menuLine3?.classList.remove("-rotate-45", "-translate-y-1.5");
      }
    }

    mobileMenuButton?.addEventListener("click", toggleMenu);

    // Close menu when clicking on a link
    mobileMenuLinks.forEach((link) => {
      link.addEventListener("click", () => {
        if (isMenuOpen) {
          toggleMenu();
        }
      });
    });
  });
</script>
