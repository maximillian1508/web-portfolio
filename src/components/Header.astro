---
import { pageMap } from "@lib/pageMap";
import {
  useTranslations,
  getLangFromUrl,
  useTranslatedPath,
} from "@i18n/utils";
import { Image } from "astro:assets";
import MlIcon from "@assets/ml-icon.png";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Get current URL language
const currentLang = getLangFromUrl(Astro.url);
const pathname = Astro.url.pathname;

// Remove language prefix to get base path
let basePath = pathname;
if (currentLang !== "en" && pathname.startsWith(`/${currentLang}`)) {
  basePath = pathname.replace(`/${currentLang}`, "") || "/";
}

// For non-English routes, reverse translate to get the original route
if (currentLang !== "en" && basePath !== "/") {
  const { routes } = await import("@i18n/routes");
  const pathSegments = basePath.split("/").filter((s) => s);
  const originalSegments = pathSegments.map((segment) => {
    const routeMap = routes[currentLang];
    if (routeMap) {
      for (const [original, translated] of Object.entries(routeMap)) {
        if (translated === segment) {
          return original;
        }
      }
    }
    return segment;
  });
  basePath = "/" + originalSegments.join("/");
}

const currentPage = pageMap[basePath as keyof typeof pageMap] || pageMap["/"];
const totalPages = Object.keys(pageMap).length;
---

<header
  class="fixed top-0 left-0 right-0 z-50 bg-slate-950/90 backdrop-blur-sm border-b border-slate-800"
>
  <input
    type="checkbox"
    id="mobile-menu-toggle"
    class="hidden"
    aria-label="Toggle mobile menu"
  />

  <div class="max-w-[1280px] mx-auto px-4 md:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <div class="flex items-center gap-8">
        <a
          href={translatePath("/")}
          class="text-slate-400 font-mono text-sm hover:text-cyan-400 transition-colors"
        >
          <Image
            quality={100}
            src={MlIcon}
            alt="Maximillian Leonard Icon"
            width={48}
            height={48}
            priority
          />
        </a>
        <div class="hidden md:flex items-center gap-4 text-xs font-mono">
          {
            Object.entries(pageMap).map(([path, page], index) => (
              <div class="flex items-center gap-4">
                <a
                  href={translatePath(path)}
                  class={`transition-colors ${
                    basePath === path
                      ? "text-purple-400"
                      : "text-slate-400 hover:text-cyan-400"
                  }`}
                >
                  {t(page.nameKey)}
                </a>
                {index < Object.keys(pageMap).length - 1 && (
                  <span class="text-slate-600">•</span>
                )}
              </div>
            ))
          }
        </div>
      </div>

      <div class="hidden md:block text-slate-400 font-mono text-sm">
        <span class="text-purple-400">
          {t("common:page")}
          {currentPage.number}
          {t("common:of")}
          {totalPages}
        </span>
      </div>

      <label
        for="mobile-menu-toggle"
        class="md:hidden w-8 h-6 cursor-pointer relative inline-block"
      >
        <span class="hamburger-inner"></span>
      </label>
    </div>

    <nav class="md:hidden border-t border-slate-800 py-4 hidden">
      <div class="flex flex-col gap-4 text-sm">
        {
          Object.entries(pageMap).map(([path, page]) => (
            <a
              href={translatePath(path)}
              class={`transition-colors py-2 ${
                basePath === path
                  ? "text-purple-400"
                  : "text-slate-300 hover:text-cyan-400"
              }`}
            >
              {t(page.nameKey)}
            </a>
          ))
        }
        <div
          class="text-slate-400 font-mono text-xs pt-2 border-t border-slate-800"
        >
          {t("common:page")}
          {currentPage.number}
          {t("common:of")}
          {totalPages}
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  /* Hamburger styles */
  .hamburger-inner {
    display: block;
    top: 50%;
    margin-top: -2px;
    width: 24px;
    height: 2px;
    background-color: #cbd5e1;
    border-radius: 4px;
    position: absolute;
    transition-property: none;
  }

  .hamburger-inner::before,
  .hamburger-inner::after {
    content: "";
    display: block;
    width: 24px;
    height: 2px;
    background-color: #cbd5e1;
    border-radius: 4px;
    position: absolute;
    transition-property: none;
  }

  .hamburger-inner::before {
    top: -6px;
  }

  .hamburger-inner::after {
    bottom: -6px;
  }

  /* Hamburger → X animation when checked (boring style) */
  #mobile-menu-toggle:checked ~ div label .hamburger-inner {
    transform: rotate(45deg);
  }

  #mobile-menu-toggle:checked ~ div label .hamburger-inner::before {
    top: 0;
    opacity: 0;
  }

  #mobile-menu-toggle:checked ~ div label .hamburger-inner::after {
    bottom: 0;
    transform: rotate(-90deg);
  }

  /* Show mobile nav when checkbox is checked */
  #mobile-menu-toggle:checked ~ div nav {
    @apply block;
  }
</style>
