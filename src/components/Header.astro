---
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";
import ThemeToggle from "./ThemeToggle.astro";
import LanguageToggle from "./LanguageToggle.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header
  class="fixed top-0 w-full z-50 bg-background/80 backdrop-blur-md border-b border-border/50"
>
  <nav class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo/Brand -->
      <div class="flex-shrink-0">
        <a
          href={getRelativeLocaleUrl(lang, "/")}
          class="text-xl font-bold bg-gradient-to-r from-primary to-accent bg-clip-text text-transparent hover:scale-105 transition-transform duration-200"
        >
          ML
        </a>
      </div>

      <!-- Desktop Navigation -->
      <div class="hidden md:block">
        <div class="ml-10 flex items-baseline space-x-8">
          <a
            href={getRelativeLocaleUrl(lang, "/")}
            class="text-foreground hover:text-primary transition-colors duration-200 relative group"
          >
            {t("header.home")}
            <span
              class="absolute -bottom-1 left-0 w-0 h-0.5 bg-primary transition-all duration-200 group-hover:w-full"
            ></span>
          </a>
          <a
            href={getRelativeLocaleUrl(lang, "/about")}
            class="text-muted-foreground hover:text-primary transition-colors duration-200 relative group"
          >
            {t("header.about")}
            <span
              class="absolute -bottom-1 left-0 w-0 h-0.5 bg-primary transition-all duration-200 group-hover:w-full"
            ></span>
          </a>
          <a
            href={getRelativeLocaleUrl(lang, "/projects")}
            class="text-muted-foreground hover:text-primary transition-colors duration-200 relative group"
          >
            {t("header.projects")}
            <span
              class="absolute -bottom-1 left-0 w-0 h-0.5 bg-primary transition-all duration-200 group-hover:w-full"
            ></span>
          </a>
          <a
            href={getRelativeLocaleUrl(lang, "/contact")}
            class="text-muted-foreground hover:text-primary transition-colors duration-200 relative group"
          >
            {t("header.contact")}
            <span
              class="absolute -bottom-1 left-0 w-0 h-0.5 bg-primary transition-all duration-200 group-hover:w-full"
            ></span>
          </a>
        </div>
      </div>

      <!-- Language Toggle, Theme Toggle & CTA Button -->
      <div class="hidden md:flex items-center space-x-3">
        <LanguageToggle />
        <ThemeToggle />
        <a
          href={getRelativeLocaleUrl(lang, "/contact")}
          class="inline-flex items-center px-4 py-2 border border-primary/20 text-sm font-medium rounded-lg text-primary bg-primary/10 hover:bg-primary/20 backdrop-blur-sm transition-all duration-200 hover:scale-105 hover:shadow-lg hover:shadow-primary/25"
        >
          {t("button.getInTouch")}
        </a>
      </div>

      <!-- Mobile Language Toggle, Theme Toggle & Menu Button -->
      <div class="md:hidden flex items-center space-x-2">
        <LanguageToggle />
        <ThemeToggle />
        <button
          type="button"
          class="mobile-menu-button inline-flex items-center justify-center p-2 rounded-md text-muted-foreground hover:text-primary hover:bg-secondary/50 transition-colors duration-200"
          aria-expanded="false"
        >
          <span class="sr-only">Open main menu</span>
          <!-- Hamburger icon -->
          <svg
            class="h-6 w-6"
            stroke="currentColor"
            fill="none"
            viewBox="0 0 24 24"
          >
            <path
              class="menu-open"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
            <path
              class="menu-close hidden"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation Menu -->
    <div
      class="mobile-menu md:hidden hidden bg-card/95 backdrop-blur-md border border-border/50 rounded-lg mt-2 mb-4"
    >
      <div class="px-2 pt-2 pb-3 space-y-1">
        <a
          href={getRelativeLocaleUrl(lang, "/")}
          class="block px-3 py-2 text-base font-medium text-foreground hover:text-primary hover:bg-secondary/50 rounded-md transition-colors duration-200"
        >
          {t("header.home")}
        </a>
        <a
          href={getRelativeLocaleUrl(lang, "/about")}
          class="block px-3 py-2 text-base font-medium text-muted-foreground hover:text-primary hover:bg-secondary/50 rounded-md transition-colors duration-200"
        >
          {t("header.about")}
        </a>
        <a
          href={getRelativeLocaleUrl(lang, "/projects")}
          class="block px-3 py-2 text-base font-medium text-muted-foreground hover:text-primary hover:bg-secondary/50 rounded-md transition-colors duration-200"
        >
          {t("header.projects")}
        </a>
        <a
          href={getRelativeLocaleUrl(lang, "/contact")}
          class="block px-3 py-2 text-base font-medium text-muted-foreground hover:text-primary hover:bg-secondary/50 rounded-md transition-colors duration-200"
        >
          {t("header.contact")}
        </a>
        <div class="pt-2">
          <a
            href={getRelativeLocaleUrl(lang, "/contact")}
            class="block w-full text-center px-3 py-2 border border-primary/20 text-sm font-medium rounded-lg text-primary bg-primary/10 hover:bg-primary/20 transition-all duration-200"
          >
            {t("button.getInTouch")}
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  // Mobile menu toggle
  document.addEventListener("DOMContentLoaded", function () {
    const mobileMenuButton = document.querySelector(".mobile-menu-button");
    const mobileMenu = document.querySelector(".mobile-menu");
    const menuOpen = document.querySelector(".menu-open");
    const menuClose = document.querySelector(".menu-close");

    mobileMenuButton?.addEventListener(
      "click",
      function (this: HTMLButtonElement) {
        const isExpanded = this.getAttribute("aria-expanded") === "true";

        this.setAttribute("aria-expanded", (!isExpanded).toString());
        mobileMenu?.classList.toggle("hidden");
        menuOpen?.classList.toggle("hidden");
        menuClose?.classList.toggle("hidden");
      }
    );
  });
</script>
