---
import { pageMap } from "@lib/pageMap";

const currentPath = Astro.url.pathname;
const currentPage = pageMap[currentPath] || { name: "Portfolio", number: 1 };
const totalPages = Object.keys(pageMap).length;

// Get previous and next pages
const currentNumber = currentPage.number;
const previousPage = Object.entries(pageMap).find(([_, page]) => page.number === currentNumber - 1);
const nextPage = Object.entries(pageMap).find(([_, page]) => page.number === currentNumber + 1);
---

<div class="bg-slate-950 border-t border-slate-800">
  <div class="max-w-[1280px] mx-auto px-4 md:px-6 lg:px-8 pt-8">
    <div class="flex justify-between items-center text-sm">
      <div class="text-slate-500 font-mono">
        {previousPage ? (
          <a href={previousPage[0]} class="text-purple-400 hover:text-purple-300 transition-colors">
            ← Previous: Page {previousPage[1].number}: {previousPage[1].name}
          </a>
        ) : (
          <div class="text-slate-700">← No previous page</div>
        )}
      </div>

      <div class="text-slate-500 font-mono text-center">
        <div class="text-xs text-slate-500 mb-1">Current Page</div>
        <div class="text-purple-400">
          {currentNumber} / {totalPages}: {currentPage.name}
        </div>
      </div>

      <div class="text-slate-500 font-mono">
        {nextPage ? (
          <a href={nextPage[0]} class="text-cyan-400 hover:text-cyan-300 transition-colors">
            Next: Page {nextPage[1].number}: {nextPage[1].name} →
          </a>
        ) : (
          <div class="text-slate-700">No next page →</div>
        )}
      </div>
    </div>
  </div>
</div>