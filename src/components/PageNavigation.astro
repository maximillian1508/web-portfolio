---
import { pageMap } from "@lib/pageMap";
import { useTranslations, getLangFromUrl, useTranslatedPath } from "@i18n/utils";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Get current URL language
const currentLang = getLangFromUrl(Astro.url);
const pathname = Astro.url.pathname;

// Remove language prefix to get base path
let basePath = pathname;
if (currentLang !== "en" && pathname.startsWith(`/${currentLang}`)) {
  basePath = pathname.replace(`/${currentLang}`, "") || "/";
}

// For non-English routes, reverse translate to get the original route
if (currentLang !== "en" && basePath !== "/") {
  const { routes } = await import("@i18n/routes");
  const pathSegments = basePath.split("/").filter((s) => s);
  const originalSegments = pathSegments.map((segment) => {
    const routeMap = routes[currentLang];
    if (routeMap) {
      for (const [original, translated] of Object.entries(routeMap)) {
        if (translated === segment) {
          return original;
        }
      }
    }
    return segment;
  });
  basePath = "/" + originalSegments.join("/");
}

const currentPage = pageMap[basePath as keyof typeof pageMap] || pageMap["/"];
const totalPages = Object.keys(pageMap).length;

// Get previous and next pages
const currentNumber = currentPage.number;
const previousPage = Object.entries(pageMap).find(
  ([_, page]) => page.number === currentNumber - 1
);
const nextPage = Object.entries(pageMap).find(
  ([_, page]) => page.number === currentNumber + 1
);
---

<div class="bg-slate-950 border-t border-slate-800">
  <div class="max-w-[1280px] mx-auto px-4 md:px-6 lg:px-8 pt-8">
    <div class="flex justify-between items-center text-sm">
      <div class="text-slate-500 font-mono">
        {
          previousPage ? (
            <a
              href={translatePath(previousPage[0])}
              class="text-purple-400 hover:text-purple-300 transition-colors"
            >
              ← {t(previousPage[1].nameKey)}
            </a>
          ) : (
            <div class="text-slate-700">← {t("common:noPreviousPage")}</div>
          )
        }
      </div>

      <div class="text-slate-500 font-mono text-center">
        <div class="text-xs text-slate-500 mb-1">
          {t("common:currentPage")}
        </div>
        <div class="text-purple-400">
          {currentNumber}/{totalPages}: {t(currentPage.nameKey)}
        </div>
      </div>

      <div class="text-slate-500 font-mono">
        {
          nextPage ? (
            <a
              href={translatePath(nextPage[0])}
              class="text-cyan-400 hover:text-cyan-300 transition-colors"
            >
              {t(nextPage[1].nameKey)} →
            </a>
          ) : (
            <div class="text-slate-700">{t("common:noNextPage")} →</div>
          )
        }
      </div>
    </div>
  </div>
</div>
