---
import { getLangFromUrl, useTranslations } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-800 py-8">
  <div class="max-w-[1280px] mx-auto px-4 md:px-6 lg:px-8">
    <div class="mb-6">
      <p class="text-slate-300 text-sm mb-2">
        {t("footer.interested")}
      </p>
      <a
        href="/contact"
        class="text-cyan-400 hover:text-cyan-300 transition-colors text-sm"
      >
        {t("footer.talk")} →
      </a>
    </div>

    <div
      class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 pt-6 border-t border-slate-800"
    >
      <div class="text-sm text-slate-400">
        © {currentYear} — built with astro and tailwind
      </div>

      <div class="flex items-center gap-6 text-sm">
        <a
          href="mailto:hello@maximillianleonard.dev"
          class="text-slate-300 hover:text-cyan-400 transition-colors"
        >
          {t("common.contact")}
        </a>
        <a
          href="https://github.com/maximillian1508"
          target="_blank"
          rel="noopener noreferrer"
          class="text-slate-300 hover:text-cyan-400 transition-colors"
        >
          github
        </a>
        <a
          href="https://linkedin.com/in/maximillianleonard1508"
          target="_blank"
          rel="noopener noreferrer"
          class="text-slate-300 hover:text-cyan-400 transition-colors"
        >
          linkedin
        </a>
      </div>
    </div>
  </div>
</footer>
