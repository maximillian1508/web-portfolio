---
import { useTranslations, getLangFromUrl } from "../i18n/utils";

export interface Props {
  title?: string;
  description?: string;
  showEta?: boolean;
  eta?: string;
  variant?: "default" | "page" | "section";
}

const { variant = "default", showEta = true } = Astro.props as Props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Set default translations based on variant
let defaultTitle: string;
let defaultDescription: string;
let defaultEta: string;

switch (variant) {
  case "page":
    defaultTitle = "page under construction";
    defaultDescription = "building something awesome with modern technology and clean architecture";
    break;
  case "section":
    defaultTitle = "section in progress";
    defaultDescription = "implementing new features with performance and scalability in mind";
    break;
  default:
    defaultTitle = "under construction";
    defaultDescription = "crafting high-performance solutions with attention to detail";
    break;
}

defaultEta = "coming soon";

const {
  title = defaultTitle,
  description = defaultDescription,
  eta = defaultEta,
} = Astro.props as Props;
---

<section class="py-24 relative overflow-hidden">
  <div class="relative max-w-[1280px] mx-auto px-4 md:px-6 lg:px-8 text-center">
    <!-- Title -->
    <h2 class="text-2xl sm:text-3xl font-bold mb-6">
      <span class="text-cyan-400">under</span> construction
    </h2>

    <!-- Description -->
    <p class="text-slate-300 text-sm leading-relaxed mb-8 max-w-md mx-auto">
      {description}
    </p>

    <!-- ETA Badge -->
    {
      showEta && (
        <div class="inline-flex items-center px-4 py-2 rounded-full border border-slate-800 text-purple-400 text-sm mb-8">
          <div class="w-2 h-2 bg-purple-400 rounded-full mr-2 animate-pulse" />
          {eta}
        </div>
      )
    }

    <!-- Code Block Simulation -->
    <div class="max-w-lg mx-auto">
      <div class="bg-slate-900 border border-slate-800 rounded-lg p-6 text-left">
        <div class="flex items-center justify-between mb-4">
          <div class="flex space-x-2">
            <div class="w-3 h-3 bg-red-500 rounded-full"></div>
            <div class="w-3 h-3 bg-yellow-500 rounded-full"></div>
            <div class="w-3 h-3 bg-green-500 rounded-full"></div>
          </div>
          <span class="text-xs text-slate-500 font-mono">development.ts</span>
        </div>
        <div class="space-y-2 font-mono text-sm">
          <div class="text-slate-400">
            <span class="text-purple-400">const</span>
            <span class="text-slate-100 ml-1">status</span>
            <span class="text-slate-300 ml-1">=</span>
            <span class="text-cyan-400 ml-1">'building'</span>
            <span class="text-slate-300">;</span>
          </div>
          <div class="text-slate-400">
            <span class="text-purple-400">const</span>
            <span class="text-slate-100 ml-1">progress</span>
            <span class="text-slate-300 ml-1">=</span>
            <span class="text-cyan-400 ml-1 animate-pulse">85</span>
            <span class="text-slate-300">%;</span>
          </div>
          <div class="text-slate-400">
            <span class="text-purple-400">console</span>
            <span class="text-slate-300">.</span>
            <span class="text-cyan-400">log</span>
            <span class="text-slate-300">(</span>
            <span class="text-cyan-400">'almost ready...'</span>
            <span class="text-slate-300">);</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Back to Home -->
    <div class="mt-12">
      <a
        href="/"
        class="text-slate-400 hover:text-cyan-400 transition-colors text-sm"
      >
        ← back to home
      </a>
    </div>
  </div>
</section>
