---
import Layout from "../layouts/Layout.astro";
import { useTranslations } from "../i18n/utils";
import { languages, defaultLang } from "../i18n/ui";
import { routes } from "../i18n/routes";
import PageNavigation from "@components/PageNavigation.astro";
import MasonryGallery from "@components/MasonryGallery.astro";
import { getCollection } from "astro:content";

export const prerender = false;

// Determine language from URL
const url = new URL(Astro.request.url);
const pathParts = url.pathname.split("/").filter(Boolean);

// Check if first part is a language code
let lang: "en" | "id" = defaultLang as "en" | "id";
if (pathParts[0] && pathParts[0] in languages) {
  lang = pathParts[0] as "en" | "id";
}

// Validate this is actually the hub route
const hubRoute = routes[lang]?.hub || "hub";
const expectedPath = lang === defaultLang ? `/${hubRoute}` : `/${lang}/${hubRoute}`;
if (url.pathname !== expectedPath) {
  return Astro.redirect("/404");
}

// Get all blog posts from content collection
const allPosts = await getCollection("blog", ({ data }) => {
  // Filter by language and exclude drafts in production
  return data.lang === lang && (import.meta.env.DEV || !data.draft);
});

// Sort by publication date (newest first) and limit to 5
const allSortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const posts = allSortedPosts.slice(0, 5);
const hasMorePosts = allSortedPosts.length > 5;

const t = useTranslations(lang);

const formatDate = (date: Date) => {
  const day = date.getDate().toString().padStart(2, "0");
  const month = (date.getMonth() + 1).toString().padStart(2, "0");
  const year = date.getFullYear();
  return `${day}/${month}/${year}`;
};

// Get the slug for a post (use custom slug from frontmatter or fall back to file name)
const getPostSlug = (post: (typeof posts)[number]) => {
  // Use custom slug from frontmatter if available
  if (post.data.slug) {
    return post.data.slug;
  }
  // Fall back to extracting from file id (e.g., "en/example-post" -> "example-post")
  return post.id.split("/").pop()!;
};

// Build URL for a post
const getPostUrl = (post: (typeof posts)[number]) => {
  const blogRoute = routes[lang]?.blog || "blog";
  const slug = getPostSlug(post);

  if (lang === defaultLang) {
    return `/${blogRoute}/${slug}`;
  }
  return `/${lang}/${blogRoute}/${slug}`;
};

// Build URL for blog list page
const getBlogListUrl = () => {
  const blogRoute = routes[lang]?.blog || "blog";
  if (lang === defaultLang) {
    return `/${blogRoute}`;
  }
  return `/${lang}/${blogRoute}`;
};

// Get gallery images from R2 bucket
interface GalleryImage {
  id: string;
  src: string;
  alt: string;
  caption?: string;
  width: number;
  height: number;
}

let galleryImages: GalleryImage[] = [];
const R2_PUBLIC_URL = "https://image.maximillianleonard.dev";

try {
  const { env } = Astro.locals.runtime;
  const bucket = env?.GALLERY_BUCKET;

  console.log("Env:", !!env);
  console.log("Bucket:", !!bucket);

  if (bucket) {
    const listed = await bucket.list({ prefix: "image/" });
    console.log("Listed objects:", listed.objects.length);

    galleryImages = listed.objects
      .filter((obj) => /\.(jpg|jpeg|png|gif|webp)$/i.test(obj.key))
      .sort((a, b) => {
        // Sort by upload time (newest first)
        const dateA = a.uploaded?.getTime() || 0;
        const dateB = b.uploaded?.getTime() || 0;
        return dateB - dateA;
      })
      .map((obj) => ({
        id: obj.key,
        src: `${R2_PUBLIC_URL}/${obj.key}`,
        alt: obj.key.split("/").pop()?.replace(/\.[^.]+$/, "") || "Gallery image",
        width: 400,
        height: 400,
      }));
  } else {
    console.log("No R2 bucket available - running locally without wrangler?");
  }
} catch (error) {
  console.error("Failed to fetch gallery from R2:", error);
}
---

<Layout
  title={t("hub:meta.title")}
  description={t("hub:meta.description")}
  lang={lang}
>
  <!-- Hub Header -->
  <section class="pb-12">
    <div class="max-w-4xl">
      <h1 class="text-h1 font-bold mb-6 text-cyan-400">
        {t("hub:title")}
      </h1>
      <p class="text-h4 md:text-lg text-slate-300 leading-relaxed font-light">
        {t("hub:subtitle")}
      </p>
    </div>
  </section>

  <!-- Top Section: Two Columns -->
  <div class="grid md:grid-cols-2 gap-12 mb-16">
    <!-- Left: TBD Section -->
    <section>
      <h2 class="text-lg font-semibold mb-4 text-slate-300">
        {t("hub:comingSoon")}
      </h2>
      <p class="text-slate-500 text-sm">{t("hub:underConstruction")}</p>
    </section>

    <!-- Right: Blog List (Simplified) -->
    <section>
      <h2 class="text-lg font-semibold mb-4 text-slate-300">
        {t("blog:title")}
      </h2>
      {
        posts && posts.length > 0 ? (
          <>
            <ul class="space-y-2">
              {posts.map((post) => (
                <li class="flex items-baseline justify-between gap-4">
                  <a
                    href={getPostUrl(post)}
                    class="text-slate-200 hover:text-blue-400 transition-colors truncate max-w-[200px] md:max-w-[400px]"
                  >
                    {post.data.title}
                  </a>
                  <time
                    datetime={post.data.pubDate.toISOString()}
                    class="text-xs text-slate-500 whitespace-nowrap"
                  >
                    {formatDate(post.data.pubDate)}
                  </time>
                </li>
              ))}
            </ul>
            <a
              href={getBlogListUrl()}
              class="inline-block mt-4 text-sm text-blue-400 hover:text-blue-300 transition-colors"
            >
              {t("hub:viewAllPosts")} →
            </a>
          </>
        ) : (
          <p class="text-slate-500 text-sm">{t("blog:noPosts")}</p>
        )
      }
    </section>
  </div>

  <!-- Bottom: Gallery Section -->
  <section class="my-8">
    <h2 class="text-lg font-semibold mb-4 text-slate-300">
      {t("hub:gallery")}
    </h2>
    {
      galleryImages.length > 0 ? (
        <MasonryGallery images={galleryImages} batchSize={12} />
      ) : (
        <>
          <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4 mt-6">
            <div class="aspect-square bg-slate-800/50 rounded flex items-center justify-center text-slate-600">
              <span class="text-2xl">+</span>
            </div>
          </div>
          <p class="text-slate-500 text-sm mt-4">
            {t("hub:galleryComingSoon")}
          </p>
        </>
      )
    }
  </section>

  <PageNavigation lang={lang} />
</Layout>
