---
import Layout from "../layouts/Layout.astro";
import { useTranslations } from "../i18n/utils";
import { languages, defaultLang } from "../i18n/ui";
import { routes } from "../i18n/routes";
import PageNavigation from "@components/PageNavigation.astro";
import { getCollection } from "astro:content";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => {
    // Get translated hub route for this language
    const hubRoute = routes[lang]?.hub || "hub";

    // Build the full path param
    const pathParam = lang === defaultLang ? hubRoute : `${lang}/${hubRoute}`;

    return {
      params: { hub: pathParam },
      props: { lang: lang as "en" | "id" },
    };
  });
}

interface Props {
  lang: "en" | "id";
}

const { lang } = Astro.props;

// Get all blog posts from content collection
const allPosts = await getCollection("blog", ({ data }) => {
  // Filter by language and exclude drafts in production
  return data.lang === lang && (import.meta.env.DEV || !data.draft);
});

// Sort by publication date (newest first) and limit to 5
const allSortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const posts = allSortedPosts.slice(0, 5);
const hasMorePosts = allSortedPosts.length > 5;

const t = useTranslations(lang);

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat(lang === "en" ? "en-US" : "id-ID", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }).format(date);
};

// Get the slug for a post (use custom slug from frontmatter or fall back to file name)
const getPostSlug = (post: (typeof posts)[number]) => {
  // Use custom slug from frontmatter if available
  if (post.data.slug) {
    return post.data.slug;
  }
  // Fall back to extracting from file id (e.g., "en/example-post" -> "example-post")
  return post.id.split("/").pop()!;
};

// Build URL for a post
const getPostUrl = (post: (typeof posts)[number]) => {
  const blogRoute = routes[lang]?.blog || "blog";
  const slug = getPostSlug(post);

  if (lang === defaultLang) {
    return `/${blogRoute}/${slug}`;
  }
  return `/${lang}/${blogRoute}/${slug}`;
};

// Build URL for blog list page
const getBlogListUrl = () => {
  const blogRoute = routes[lang]?.blog || "blog";
  if (lang === defaultLang) {
    return `/${blogRoute}`;
  }
  return `/${lang}/${blogRoute}`;
};
---

<Layout title={t("hub:meta.title")} description={t("hub:meta.description")} lang={lang}>
  <!-- Hub Header -->
  <section class="pb-12">
    <div class="max-w-4xl">
      <h1 class="text-h1 font-bold mb-6 text-cyan-400">
        {t("hub:title")}
      </h1>
      <p class="text-h4 md:text-lg text-slate-300 leading-relaxed font-light">
        {t("hub:subtitle")}
      </p>
    </div>
  </section>

  <!-- Top Section: Two Columns -->
  <div class="grid md:grid-cols-2 gap-12 mb-16">
    <!-- Left: TBD Section -->
    <section>
      <h2 class="text-lg font-semibold mb-4 text-slate-300">
        {t("hub:comingSoon")}
      </h2>
      <p class="text-slate-500 text-sm">{t("hub:underConstruction")}</p>
    </section>

    <!-- Right: Blog List (Simplified) -->
    <section>
      <h2 class="text-lg font-semibold mb-4 text-slate-300">
        {t("blog:title")}
      </h2>
      {
        posts && posts.length > 0 ? (
          <>
            <ul class="space-y-2">
              {posts.map((post) => (
                <li class="flex justify-between items-baseline gap-4">
                  <a
                    href={getPostUrl(post)}
                    class="text-slate-200 hover:text-blue-400 transition-colors truncate"
                  >
                    {post.data.title}
                  </a>
                  <time
                    datetime={post.data.pubDate.toISOString()}
                    class="text-xs text-slate-500 whitespace-nowrap"
                  >
                    {formatDate(post.data.pubDate)}
                  </time>
                </li>
              ))}
            </ul>
            {hasMorePosts && (
              <a
                href={getBlogListUrl()}
                class="inline-block mt-4 text-sm text-blue-400 hover:text-blue-300 transition-colors"
              >
                {t("hub:viewAllPosts")} →
              </a>
            )}
          </>
        ) : (
          <p class="text-slate-500 text-sm">{t("blog:noPosts")}</p>
        )
      }
    </section>
  </div>

  <!-- Bottom: Gallery Section -->
  <section class="my-8">
    <h2 class="text-lg font-semibold mb-4 text-slate-300">
      {t("hub:gallery")}
    </h2>
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4 mt-6">
      <!-- Placeholder for images -->
      <div
        class="aspect-square bg-slate-800/50 rounded flex items-center justify-center text-slate-600"
      >
        <span class="text-2xl">+</span>
      </div>
    </div>
    <p class="text-slate-500 text-sm mt-4">{t("hub:galleryComingSoon")}</p>
  </section>

  <PageNavigation lang={lang} />
</Layout>
