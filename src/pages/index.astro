---
import Layout from "@layouts/Layout.astro";
import PageNavigation from "@components/PageNavigation.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Experience data
const experiences = [
  {
    company: "Property Genie",
    companyUrl: "https://www.propertygenie.com.my",
    role: "Full-Stack Developer",
    period: "2024 - Present",
    description:
      "Developed and maintained the company's web application. Improved the company's search page result implementation. ",
    metrics: "50% higher impressions & clicks",
    tech: "PHP • Yii2 • PostgreSQL • React.js • JavaScript • CSS",
  },
  {
    company: "Nexea",
    companyUrl: "https://www.nexea.co/",
    role: "Software Developer Intern",
    period: "July 2023 - November 2023",
    description:
      "Developed several features for client's booking system. Performed UAT on an ERP system. Documented a project's setup and configuration guidelines.",
    metrics: "2+ features developed",
    tech: "React.js • Node.js • Express.js • MongoDB • JavaScript",
  },
];

// Projects data
const projects = [
  {
    title: "EasyRent",
    description:
      "A web application for property agents to manage their listings and bookings.",
    tech: "React.js • Express.js • MongoDB • Docker • Stripe",
    metrics: undefined,
    testimonial: undefined,
    githubUrl: "https://github.com/maximillian1508/easyrent",
    liveUrl: "https://easyrent.maximillianleonard.dev",
  },
  // {
  //   title: "AI Content Generator",
  //   description:
  //     "Intelligent content creation platform powered by machine learning. Features advanced text generation, image processing, and collaborative editing capabilities.",
  //   tech: "React • Python • FastAPI • OpenAI • Docker",
  //   metrics:
  //     "1M+ content pieces generated, 25K+ users served, <200ms response time",
  //   testimonial:
  //     "The AI platform has changed the way we think about content creation and user engagement.",
  //   githubUrl: "https://github.com/maximillianleonard/ai-content-generator",
  //   liveUrl: "https://ai-content-gen.com",
  // },
  // {
  //   title: "E-Commerce Platform",
  //   description:
  //     "Full-stack e-commerce solution with advanced inventory management, payment processing, and analytics. Handles high-volume transactions with 99.9% uptime.",
  //   tech: "Vue.js • Node.js • MongoDB • Stripe • AWS",
  //   metrics: "500K+ transactions, $2M+ revenue processed, 3.2% conversion rate",
  //   testimonial:
  //     "It's been amazing to work with this platform. The performance improvements are actually useful for our business.",
  //   githubUrl: "https://github.com/maximillianleonard/ecommerce-platform",
  //   liveUrl: "https://ecommerce-platform.com",
  // },
];
---

<Layout title={t("home.title")}>
  <!-- Hero Section -->
  <section class="relative flex items-start justify-start px-4">
    <div class="w-full max-w-4xl">
      <h1
        class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold mb-4 sm:mb-6 bg-gradient-to-r from-cyan-400 to-purple-400 bg-clip-text text-transparent"
      >
        Maximillian Leonard
      </h1>

      <p
        class="text-base sm:text-lg md:text-xl text-slate-300 mb-8 sm:mb-12 leading-relaxed font-light"
      >
        full-stack developer building high-performance applications: fast,
        scalable, and extremely reliable
      </p>

      <div
        class="flex flex-wrap items-center gap-2 sm:gap-4 md:gap-8 text-slate-400 text-xs sm:text-sm"
      >
        <span>React.js</span>
        <span class="hidden sm:inline">•</span>
        <span>Node.js</span>
        <span class="hidden sm:inline">•</span>
        <span>PostgreSQL</span>
        <span class="hidden sm:inline">•</span>
        <span>PHP Yii2</span>
      </div>
    </div>
  </section>

  <!-- Skills Section -->
  <section id="skills" class="py-12 px-4">
    <div>
      <h2 class="text-xl font-bold mb-8">
        <span class="text-cyan-400">Technical</span> Stack
      </h2>

      <div class="space-y-4">
        <div class="border-b border-slate-800 pb-4 last:border-b-0">
          <div class="grid md:grid-cols-4 gap-4 items-start">
            <h3 class="text-base font-semibold text-purple-400">Frontend</h3>
            <div class="md:col-span-3">
              <p class="text-slate-300 text-sm leading-relaxed">
                React.js, Vite, Next.js, MUI, Mantine
              </p>
            </div>
          </div>
        </div>
        <div class="border-b border-slate-800 pb-4 last:border-b-0">
          <div class="grid md:grid-cols-4 gap-4 items-start">
            <h3 class="text-base font-semibold text-purple-400">Backend</h3>
            <div class="md:col-span-3">
              <p class="text-slate-300 text-sm leading-relaxed">
                Node.js, Express.js, PHP, Yii2, PostgreSQL, MongoDB
              </p>
            </div>
          </div>
        </div>
        <div class="border-b border-slate-800 pb-4 last:border-b-0">
          <div class="grid md:grid-cols-4 gap-4 items-start">
            <h3 class="text-base font-semibold text-purple-400">DevOps</h3>
            <div class="md:col-span-3">
              <p class="text-slate-300 text-sm leading-relaxed">
                Docker, Nginx, Cloudflared, Prometheus, Grafana
              </p>
            </div>
          </div>
        </div>
        <div class="pb-4">
          <div class="grid md:grid-cols-4 gap-4 items-start">
            <h3 class="text-base font-semibold text-purple-400">Tools</h3>
            <div class="md:col-span-3">
              <p class="text-slate-300 text-sm leading-relaxed">
                Git, Postman, DBeaver
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-8 pt-8 border-t border-slate-800">
        <div class="grid md:grid-cols-3 gap-8">
          <div>
            <div class="text-3xl font-bold text-cyan-400 mb-2">2+</div>
            <div class="text-slate-400 text-sm uppercase tracking-wide">
              Years Experience
            </div>
          </div>
          <div>
            <div class="text-3xl font-bold text-purple-400 mb-2">3+</div>
            <div class="text-slate-400 text-sm uppercase tracking-wide">
              Projects Delivered
            </div>
          </div>
          <!-- <div>
            <div class="text-3xl font-bold text-cyan-400 mb-2">99.9%</div>
            <div class="text-slate-400 text-sm uppercase tracking-wide">
              Uptime Achieved
            </div>
          </div> -->
        </div>
      </div>
    </div>
  </section>

  <!-- Experience Section -->
  <section id="experience" class="py-12 px-4">
    <div>
      <h2 class="text-xl font-bold mb-8">
        <span class="text-purple-400">Professional</span> Experience
      </h2>

      <div class="space-y-8">
        {
          experiences.map((exp, index) => (
            <div
              class={`${index < experiences.length - 1 ? "border-b border-slate-800" : ""} pb-8`}
            >
              <div class="grid md:grid-cols-4 gap-8">
                <div class="md:col-span-1">
                  <h3 class="text-lg font-bold mb-2">
                    <a
                      href={exp.companyUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-white hover:text-cyan-400 transition-colors duration-200"
                    >
                      {exp.company}
                    </a>
                  </h3>
                  <h4 class="text-base text-cyan-400 mb-2">{exp.role}</h4>
                  <p class="text-slate-400 text-sm">{exp.period}</p>
                </div>
                <div class="md:col-span-3 space-y-4">
                  <p class="text-slate-300 text-sm leading-relaxed">
                    {exp.description}
                  </p>
                  <p class="text-cyan-400 text-sm">{exp.metrics}</p>
                  <p class="text-purple-400 text-sm">{exp.tech}</p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Projects Section -->
  <section id="projects" class="py-12 px-4">
    <div>
      <h2 class="text-xl font-bold mb-8">
        <span class="text-cyan-400">Featured</span> Projects
      </h2>

      <div class="space-y-8">
        {
          projects.map((project, index) => (
            <div
              class={`${index < projects.length - 1 ? "border-b border-slate-800" : ""} pb-8`}
            >
              <div class="space-y-6">
                <div>
                  <div class="flex items-center gap-4 mb-4">
                    <h3 class="text-lg font-bold text-white">
                      {project.title}
                    </h3>
                    <div class="flex gap-3">
                      <a
                        href={project.githubUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-slate-400 hover:text-cyan-400 transition-colors duration-200 text-sm"
                      >
                        GitHub
                      </a>
                      <a
                        href={project.liveUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-slate-400 hover:text-purple-400 transition-colors duration-200 text-sm"
                      >
                        Live Site
                      </a>
                    </div>
                  </div>
                  <p class="text-slate-300 text-sm leading-relaxed mb-4">
                    {project.description}
                  </p>
                  <p class="text-purple-400 text-sm">{project.tech}</p>
                  {project.metrics && (
                    <p class="text-cyan-400 text-sm mt-4">{project.metrics}</p>
                  )}
                </div>

                {project.testimonial && (
                  <blockquote class="border-l-2 border-slate-700 mt-6 pl-6">
                    <p class="text-slate-400 italic text-sm leading-relaxed">
                      "{project.testimonial}"
                    </p>
                    <footer class="mt-2 text-slate-500 text-sm">
                      — Client Testimonial
                    </footer>
                  </blockquote>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <PageNavigation />
</Layout>
