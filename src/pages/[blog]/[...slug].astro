---
import Layout from "@layouts/Layout.astro";
import { useTranslations } from "@i18n/utils";
import { languages, defaultLang } from "@i18n/ui";
import { routes } from "@i18n/routes";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");

  const paths = allPosts
    .filter((post) => import.meta.env.DEV || !post.data.draft)
    .map((post) => {
      const lang = post.data.lang;

      // Get the slug - use custom slug from frontmatter or fall back to post id
      const slug = post.data.slug || post.id;

      // Get translated blog route for this language
      const blogRoute = routes[lang]?.blog || "blog";

      // Build the full blog path param (includes language prefix for non-default)
      const blogPath = lang === defaultLang ? blogRoute : `${lang}/${blogRoute}`;

      return {
        params: {
          blog: blogPath,
          slug: slug,
        },
        props: { post, lang: lang as "en" | "id" },
      };
    });

  return paths;
}

interface Props {
  post: Awaited<ReturnType<typeof getCollection>>[number];
  lang: "en" | "id";
}

const { post, lang } = Astro.props;

// Get all posts again for finding translations
const allPosts = await getCollection("blog");

// Get translations
const t = useTranslations(lang);

// Render MDX content
const { Content } = await render(post);

// Format date
const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat(lang === "en" ? "en-US" : "id-ID", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }).format(date);
};

// Get the blog list URL for this language
const blogRoute = routes[lang]?.blog || "blog";
const blogListUrl = lang === defaultLang ? `/${blogRoute}` : `/${lang}/${blogRoute}`;

// Build alternate URLs for language switching using translationKey
const alternateUrls: Record<string, string> = {};
const siteUrl = Astro.site?.origin || "https://maximillianleonard.dev";
const currentTranslationKey = post.data.translationKey;

for (const langKey of Object.keys(languages)) {
  // Find the translation of this post using translationKey
  const translatedPost = allPosts.find((p) => {
    return p.data.lang === langKey && p.data.translationKey === currentTranslationKey;
  });

  if (translatedPost) {
    const translatedSlug = translatedPost.data.slug || translatedPost.id;
    const translatedBlogRoute = routes[langKey]?.blog || "blog";

    if (langKey === defaultLang) {
      alternateUrls[langKey] = `${siteUrl}/${translatedBlogRoute}/${translatedSlug}`;
    } else {
      alternateUrls[langKey] = `${siteUrl}/${langKey}/${translatedBlogRoute}/${translatedSlug}`;
    }
  }
}
---

<Layout
  title={post.data.title}
  description={post.data.description || post.data.title}
  lang={lang}
  alternateUrls={alternateUrls}
>
  <article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Article Header -->
    <section class="mb-8">
      {
        post.data.featuredImage && (
          <Image
            quality={100}
            src={post.data.featuredImage}
            alt={post.data.title}
            class="w-full h-64 object-cover rounded-lg mb-6 shadow-lg"
            width={1000}
            height={1000}
            priority
          />
        )
      }

      <h1 class="font-bold mb-4">
        {post.data.title}
      </h1>

      <div
        class="flex items-center gap-4 text-sm text-gray-600 dark:text-gray-400"
      >
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        {
          post.data.updatedDate &&
            post.data.updatedDate.getTime() !== post.data.pubDate.getTime() && (
              <span>
                • {t("blog:updatedOn")} {formatDate(post.data.updatedDate)}
              </span>
            )
        }
      </div>
    </section>

    <!-- Article Content -->
    <div class="blog-content">
      <Content />
    </div>

    <!-- Article Footer -->
    <section class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-800">
      <div class="flex justify-between items-center">
        <a
          href={blogListUrl}
          class="text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-2"
        >
          <span>←</span>
          <span>{t("blog:backToList")}</span>
        </a>
      </div>
    </section>
  </article>
</Layout>
