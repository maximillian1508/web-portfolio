---
import Layout from "../layouts/Layout.astro";
import type { PostWithTranslation } from "../lib/blog";
import { useTranslations } from "../i18n/utils";
import PageNavigation from "@components/PageNavigation.astro";
import { supabase } from "@services/supabase";

export async function getStaticPaths() {
  return [
    { params: { blog: "blog" }, props: { lang: "en" as const } },
    { params: { blog: "id/blog" }, props: { lang: "id" as const } },
  ];
}

interface Props {
  lang: "en" | "id";
}

const { lang } = Astro.props;

const { data: langData } = await supabase
  .from("languages")
  .select("id")
  .eq("code", lang)
  .single();

let posts: PostWithTranslation[] = [];

if (langData) {
  const { data, error } = await supabase
    .from("post_translations")
    .select(
      `
      *,
      post:posts(*),
      language:languages(*)
    `
    )
    .eq("language_id", langData.id)
    .eq("is_published", true)
    .order("created_at", { ascending: false });

  if (data && !error) {
    posts = data
      .map((item: any) => ({
        ...item.post,
        translation: {
          id: item.id,
          post_id: item.post_id,
          language_id: item.language_id,
          slug: item.slug,
          title: item.title,
          description: item.description,
          content: item.content,
          is_published: item.is_published,
          created_at: item.created_at,
          updated_at: item.updated_at,
        },
        language: item.language,
      }))
      .filter((post: any) => post.is_published);
  }
}

const t = useTranslations(lang);

const formatDate = (dateString: string) => {
  const date = new Date(dateString);
  return new Intl.DateTimeFormat(lang === "en" ? "en-US" : "id-ID", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }).format(date);
};
---

<Layout title={t("blog:title")} description={t("blog:description")} lang={lang}>
  <section>
    <div class="max-w-4xl">
      <h1 class="font-bold text-h1 mb-6">
        {t("blog:title")}
      </h1>
      <p class="text-h4 md:text-lg text-slate-300 leading-relaxed font-light">
        {t("blog:description")}
      </p>
    </div>
  </section>

  <!-- Posts Grid -->
  {
    posts && posts.length > 0 ? (
      <div class="py-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post: PostWithTranslation) => (
          <article class="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-shadow">
            {post.featured_image && (
              <a
                href={
                  lang === "en"
                    ? `/blog/${post.translation.slug}`
                    : `/id/blog/${post.translation.slug}`
                }
              >
                <img
                  src={post.featured_image}
                  alt={post.translation.title}
                  class="w-full h-48 object-cover hover:opacity-90 transition-opacity"
                />
              </a>
            )}

            <div class="p-6">
              <time
                datetime={post.translation.created_at}
                class="text-sm text-gray-500 dark:text-gray-400"
              >
                {formatDate(post.translation.created_at)}
              </time>

              <h2 class="text-2xl font-bold mt-2 mb-3">
                <a
                  href={
                    lang === "en"
                      ? `/blog/${post.translation.slug}`
                      : `/id/blog/${post.translation.slug}`
                  }
                  class="text-gray-900 dark:text-gray-100 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
                >
                  {post.translation.title}
                </a>
              </h2>

              {post.translation.description && (
                <p class="text-gray-600 dark:text-gray-400 mb-4 line-clamp-3">
                  {post.translation.description}
                </p>
              )}

              <a
                href={
                  lang === "en"
                    ? `/blog/${post.translation.slug}`
                    : `/id/blog/${post.translation.slug}`
                }
                class="text-blue-600 dark:text-blue-400 hover:underline font-medium inline-flex items-center gap-2"
              >
                <span>{t("blog:readMore")}</span>
                <span>→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="text-center py-12">
        <div class="text-6xl mb-4">📝</div>
        <p class="text-xl text-gray-500 dark:text-gray-400">
          {t("blog:noPosts")}
        </p>
      </div>
    )
  }
  <PageNavigation lang={lang} />
</Layout>
