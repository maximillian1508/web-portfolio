---
import Layout from "../layouts/Layout.astro";
import { useTranslations, useTranslatedPath } from "../i18n/utils";
import { languages, defaultLang } from "../i18n/ui";
import { routes } from "../i18n/routes";
import PageNavigation from "@components/PageNavigation.astro";
import { getCollection } from "astro:content";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => {
    // Get translated blog route for this language
    const blogRoute = routes[lang]?.blog || "blog";

    // Build the full path param
    const pathParam = lang === defaultLang ? blogRoute : `${lang}/${blogRoute}`;

    return {
      params: { blog: pathParam },
      props: { lang: lang as "en" | "id" },
    };
  });
}

interface Props {
  lang: "en" | "id";
}

const { lang } = Astro.props;

// Get all blog posts from content collection
const allPosts = await getCollection("blog", ({ data }) => {
  // Filter by language and exclude drafts in production
  return data.lang === lang && (import.meta.env.DEV || !data.draft);
});

// Sort by publication date (newest first)
const posts = allPosts.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat(lang === "en" ? "en-US" : "id-ID", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }).format(date);
};

// Get the slug for a post (use custom slug from frontmatter or fall back to file name)
const getPostSlug = (post: (typeof posts)[number]) => {
  // Use custom slug from frontmatter if available
  if (post.data.slug) {
    return post.data.slug;
  }
  // Fall back to extracting from file id (e.g., "en/example-post" -> "example-post")
  return post.id.split("/").pop()!;
};

// Build URL for a post
const getPostUrl = (post: (typeof posts)[number]) => {
  const blogRoute = routes[lang]?.blog || "blog";
  const slug = getPostSlug(post);

  if (lang === defaultLang) {
    return `/${blogRoute}/${slug}`;
  }
  return `/${lang}/${blogRoute}/${slug}`;
};
---

<Layout title={t("blog:title")} description={t("blog:description")} lang={lang}>
  <a
    href={translatePath("/hub")}
    class="inline-flex items-center gap-2 text-sm text-slate-400 hover:text-blue-400 transition-colors mb-6"
  >
    <span>←</span>
    <span>{t("blog:backToHub")}</span>
  </a>

  <section>
    <div class="max-w-4xl">
      <h1 class="font-bold text-h1 mb-6">
        {t("blog:title")}
      </h1>
      <p class="text-h4 md:text-lg text-slate-300 leading-relaxed font-light">
        {t("blog:description")}
      </p>
    </div>
  </section>

  <!-- Posts Grid -->
  {
    posts && posts.length > 0 ? (
      <div class="py-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <article class="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-shadow">
            {post.data.featuredImage && (
              <a href={getPostUrl(post)}>
                <img
                  src={post.data.featuredImage}
                  alt={post.data.title}
                  class="w-full h-48 object-cover hover:opacity-90 transition-opacity"
                />
              </a>
            )}

            <div class="p-6">
              <time
                datetime={post.data.pubDate.toISOString()}
                class="text-sm text-gray-500 dark:text-gray-400"
              >
                {formatDate(post.data.pubDate)}
              </time>

              <h2 class="text-2xl font-bold mt-2 mb-3">
                <a
                  href={getPostUrl(post)}
                  class="text-gray-900 dark:text-gray-100 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
                >
                  {post.data.title}
                </a>
              </h2>

              {post.data.description && (
                <p class="text-gray-600 dark:text-gray-400 mb-4 line-clamp-3">
                  {post.data.description}
                </p>
              )}

              <a
                href={getPostUrl(post)}
                class="text-blue-600 dark:text-blue-400 hover:underline font-medium inline-flex items-center gap-2"
              >
                <span>{t("blog:readMore")}</span>
                <span>→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="text-center py-12">
        <div class="text-6xl mb-4">📝</div>
        <p class="text-xl text-gray-500 dark:text-gray-400">
          {t("blog:noPosts")}
        </p>
      </div>
    )
  }
</Layout>
