---
import Layout from "@layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title="404 - Page Not Found" robots="noindex, nofollow">
  <div class="text-center max-w-2xl mx-auto">
    <!-- Error Code -->
    <div class="mb-8">
      <h1
        class="text-8xl sm:text-9xl font-bold leading-none bg-gradient-to-r from-cyan-400 to-purple-400 bg-clip-text text-transparent"
      >
        404
      </h1>
    </div>

    <!-- Error Message -->
    <h2 class="text-2xl sm:text-3xl font-bold text-white mb-6">
      page not found
    </h2>

    <p class="text-slate-300 text-sm leading-relaxed mb-8 max-w-md mx-auto">
      the requested resource doesn't exist in this directory. check the url or
      navigate back to a valid endpoint.
    </p>

    <!-- Action Buttons -->
    <div
      class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-12"
    >
      <a
        href="/"
        class="inline-flex items-center px-6 py-3 text-cyan-400 hover:text-cyan-300 transition-colors text-sm"
      >
        <svg
          class="mr-2 w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
          ></path>
        </svg>
        return home
      </a>

      <button
        onclick="history.back()"
        class="inline-flex items-center px-6 py-3 text-slate-400 hover:text-purple-400 transition-colors text-sm"
      >
        <svg
          class="mr-2 w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        go back
      </button>
    </div>

    <!-- Error Details -->
    <div class="border border-slate-800 rounded-lg p-6 text-left">
      <div class="font-mono text-sm space-y-2">
        <div class="text-slate-400">
          <span class="text-purple-400">HTTP</span>
          <span class="text-slate-300 ml-2">404</span>
          <span class="text-cyan-400 ml-2">Not Found</span>
        </div>
        <div class="text-slate-400">
          <span class="text-purple-400">Path</span>
          <span class="text-slate-300 ml-2" id="current-path"></span>
        </div>
        <div class="text-slate-400">
          <span class="text-purple-400">Timestamp</span>
          <span class="text-slate-300 ml-2" id="timestamp"></span>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const pathEl = document.getElementById("current-path");
    const timestampEl = document.getElementById("timestamp");

    if (pathEl) {
      pathEl.textContent = window.location.pathname;
    }

    if (timestampEl) {
      timestampEl.textContent = new Date().toISOString();
    }
  });
</script>

<script>
  // Add some interactive behavior
  document.addEventListener("DOMContentLoaded", function () {
    const searchInput = document.querySelector(
      'input[type="text"]'
    ) as HTMLInputElement;
    const searchButton = document.querySelector("button") as HTMLButtonElement;

    if (searchInput && searchButton) {
      searchButton.addEventListener("click", function () {
        const query = searchInput.value.trim();
        if (query) {
          // Redirect to home with search intent
          window.location.href = `/?search=${encodeURIComponent(query)}`;
        }
      });

      searchInput.addEventListener("keypress", function (e: KeyboardEvent) {
        if (e.key === "Enter") {
          searchButton.click();
        }
      });
    }
  });
</script>

<style>
  @keyframes gradient {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  .animate-gradient {
    animation: gradient 3s ease infinite;
  }
</style>
