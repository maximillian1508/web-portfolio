---
import Layout from "@layouts/Layout.astro";
import PageNavigation from "@components/PageNavigation.astro";
import { useTranslations, getLangFromAstro } from "@i18n/utils";

const lang = getLangFromAstro(Astro);
const t = useTranslations(lang);

// Contact methods data
const contactMethods = [
  {
    method: "Email",
    value: "hello@maximillianleonard.dev",
    href: "mailto:hello@maximillianleonard.dev",
    description: "Best for project inquiries and collaboration",
    response: "< 24 hours",
  },
  {
    method: "LinkedIn",
    value: "/in/maximillianleonard1508",
    href: "https://linkedin.com/in/maximillianleonard1508",
    description: "Professional networking and career discussions",
    response: "< 48 hours",
  },
  {
    method: "GitHub",
    value: "/maximillian1508",
    href: "https://github.com/maximillian1508 ",
    description: "Code reviews, open source contributions",
    response: "varies",
  },
];

// Project types
const projectTypes = [
  "Web Applications",
  "API Development",
  "Frontend Development",
  "Landing Page",
  "Performance Optimization",
  "Technical SEO",
];
---

<Layout title="Contact - Maximillian Leonard">
  <!-- Contact Header -->
  <section class="pb-12">
    <div class="max-w-4xl">
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold mb-6">
        <span class="text-purple-400">get</span> in touch
      </h1>
      <p class="text-base sm:text-lg text-slate-300 leading-relaxed font-light">
        let's discuss your next project: scalable solutions, performance
        optimization, and clean architecture
      </p>
    </div>
  </section>

  <!-- Contact Methods -->
  <section class="py-12">
    <div>
      <h2 class="text-xl font-bold mb-8">
        <span class="text-cyan-400">Contact</span> Methods
      </h2>

      <div class="space-y-8">
        {
          contactMethods.map((contact, index) => (
            <div
              class={`${index < contactMethods.length - 1 ? "border-b border-slate-800" : ""} pb-8`}
            >
              <div class="grid md:grid-cols-4 gap-8">
                <div class="md:col-span-1">
                  <h3 class="text-lg font-bold mb-2">
                    <a
                      href={contact.href}
                      target={
                        contact.href.startsWith("http") ? "_blank" : undefined
                      }
                      rel={
                        contact.href.startsWith("http")
                          ? "noopener noreferrer"
                          : undefined
                      }
                      class="text-white hover:text-cyan-400 transition-colors duration-200"
                    >
                      {contact.method}
                    </a>
                  </h3>
                  <p class="text-slate-400 text-sm">{contact.value}</p>
                </div>
                <div class="md:col-span-3 space-y-4">
                  <p class="text-slate-300 text-sm leading-relaxed">
                    {contact.description}
                  </p>
                  <p class="text-purple-400 text-sm">
                    Response time: {contact.response}
                  </p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Project Types -->
  <section class="py-12 border-t border-slate-800">
    <div>
      <h2 class="text-xl font-bold mb-8">
        <span class="text-purple-400">Project</span> Types
      </h2>

      <div class="grid md:grid-cols-3 gap-8">
        {
          projectTypes.map((type, index) => (
            <div class="text-slate-300 text-sm">
              <span class="text-cyan-400 mr-2">•</span>
              {type}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Availability -->
  <section class="py-12 border-t border-slate-800">
    <div class="grid md:grid-cols-4 gap-8">
      <div class="md:col-span-1">
        <h2 class="text-lg font-bold text-cyan-400">Availability</h2>
      </div>
      <div class="md:col-span-3">
        <p class="text-slate-300 text-sm leading-relaxed mb-4">
          Currently not available for new projects. For urgent consultations and
          smaller engagements, I can often accommodate shorter timelines.
        </p>
        <div class="space-y-2 text-sm">
          <div class="flex justify-between items-center">
            <span class="text-slate-400">Full-time projects</span>
            <span class="text-purple-400">Not available</span>
          </div>
          <!-- <div class="flex justify-between items-center">
            <span class="text-slate-400">Consulting & audits</span>
            <span class="text-cyan-400">Available now</span>
          </div> -->
          <!-- <div class="flex justify-between items-center">
            <span class="text-slate-400">Technical mentoring</span>
            <span class="text-cyan-400">Not available</span>
          </div> -->
        </div>
      </div>
    </div>
  </section>

  <!-- Working Style -->
  <section class="py-12 border-t border-slate-800">
    <div class="grid md:grid-cols-4 gap-8">
      <div class="md:col-span-1">
        <h2 class="text-lg font-bold text-purple-400">Working Style</h2>
      </div>
      <div class="md:col-span-3">
        <p class="text-slate-300 text-sm leading-relaxed mb-4">
          I prefer collaborative, iterative approaches with regular
          communication. Strong focus on documentation, testing, and performance
          metrics throughout the development process.
        </p>
        <div class="space-y-2 text-sm">
          <div class="flex items-center">
            <span class="text-cyan-400 mr-2">•</span>
            <span class="text-slate-300"
              >Agile methodology with 1-2 week sprints</span
            >
          </div>
          <div class="flex items-center">
            <span class="text-cyan-400 mr-2">•</span>
            <span class="text-slate-300"
              >Comprehensive testing and performance monitoring</span
            >
          </div>
          <div class="flex items-center">
            <span class="text-cyan-400 mr-2">•</span>
            <span class="text-slate-300"
              >Clean handoff with clear documentation</span
            >
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-12 border-t border-slate-800">
    <div class="text-center">
      <p class="text-slate-300 text-sm mb-6">ready to start your project?</p>
      <a
        href="mailto:hello@maximillianleonard.dev?subject=Project%20Inquiry"
        class="inline-flex items-center text-cyan-400 hover:text-cyan-300 transition-colors text-sm"
      >
        send me an email →
      </a>
    </div>
  </section>
  <PageNavigation />
</Layout>
