  //   metrics: "500K+ transactions • $2M+ revenue processed • 3.2% conversion rate • 250ms avg load time",
  //   testimonial: "It's been amazing to work with this platform. The performance improvements are actually useful for our business.",
  //   githubUrl: "https://github.com/maximillianleonard/ecommerce-platform",
