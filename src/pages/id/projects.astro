---

<Layout title="Projects - Maximillian Leonard">
    <!-- Projects Header -->
    <section class="pb-12"> 
      <div class="max-w-4xl">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold mb-6">
          <span class="text-cyan-400">featured</span> projects
        </h1>
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed font-light">
          high-performance applications built for scale: from real-time analytics to machine learning platforms
        </p>
      </div>
    </section>

    <!-- Projects Grid -->
    <section>
      <div class="space-y-12">
        {projects.map((project, index) => (
          <article class={`${index < projects.length - 1 ? 'border-b border-slate-800 pb-12' : ''} `}>
            <!-- Project Header -->
            <div class="mb-6">
              <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-4">
                  <h2 class="text-xl font-bold text-white">{project.title}</h2>
                  <span class="text-xs text-slate-400 bg-slate-800 px-2 py-1 rounded">
                    {project.year}
                  </span>
                  <span class={`text-xs px-2 py-1 rounded ${
                    project.status === 'Production' 
                      ? 'text-cyan-400 bg-cyan-400/10' 
                      : 'text-purple-400 bg-purple-400/10'
                  }`}>
                    {project.status}
                  </span>
                </div>
                <div class="flex gap-3">
                  <a
                    href={project.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-slate-400 hover:text-cyan-400 transition-colors duration-200 text-sm"
                  >
                    GitHub
                  </a>
                  <a
                    href={project.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-slate-400 hover:text-purple-400 transition-colors duration-200 text-sm"
                  >
                    Live Site
                  </a>
                </div>
              </div>
              <h3 class="text-lg text-purple-400 font-semibold mb-4">{project.subtitle}</h3>
            </div>

            <!-- Project Content -->
            <div class="grid md:grid-cols-3 gap-8 mb-6">
              <div class="md:col-span-2">
                <p class="text-slate-300 text-sm leading-relaxed mb-6">{project.description}</p>
                
                <!-- Tech Stack -->
                <div class="mb-6">
                  <h4 class="text-sm font-semibold text-slate-400 mb-3 uppercase tracking-wide">Technology Stack</h4>
                  <div class="flex flex-wrap gap-2">
                    {project.tech.map((tech) => (
                      <span class="text-xs text-slate-300 bg-slate-800 px-3 py-1 rounded-full">
                        {tech}
                      </span>
                    ))}
                  </div>
                </div>
              </div>

              {
                project.metrics && (
                  <div class="md:col-span-1">
                    <!-- Metrics -->
                    <div class="mb-6">
                      <h4 class="text-sm font-semibold text-slate-400 mb-3 uppercase tracking-wide">Key Metrics</h4>
                      <p class="text-cyan-400 text-sm">{project.metrics}</p>
                    </div>
                  </div>
                )
              }
            </div>

            <!-- Testimonial -->
            {
              project.testimonial && (
                <blockquote class="border-l-2 border-slate-700 pl-6">
                  <p class="text-slate-400 italic text-sm leading-relaxed">"{project.testimonial}"</p>
                  <footer class="mt-2 text-slate-500 text-sm">— Client Testimonial</footer>
                </blockquote>
              )
            }
          </article>
        ))}
      </div>
    </section>

    <!-- Project Stats Summary -->
