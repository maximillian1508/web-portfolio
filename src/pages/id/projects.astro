          </div>
        </div>
      </div>
    </section> -->

    <!-- CTA -->
    <section class="py-12 border-t border-slate-800">
      <div class="text-center">
        <p class="text-slate-300 text-sm mb-6">interested in similar results for your project?</p>
        <a
          href="/contact"
          class="text-cyan-400 hover:text-cyan-300 transition-colors text-sm"
        >
          let's discuss your requirements →
        </a>
      </div>
    </section>
    <PageNavigation />
</Layout>

