---
import Layout from "@layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title="500 - Internal Server Error" robots="noindex, nofollow">
  <section
    class="relative min-h-screen flex items-center justify-center overflow-hidden pt-16"
  >
    <!-- Background Elements -->
    <div
      class="absolute inset-0 bg-gradient-to-br from-background via-background to-background/95"
    >
    </div>
    <div class="absolute inset-0 bg-radial-primary"></div>
    <div class="absolute inset-0 bg-radial-accent"></div>

    <!-- Grid Pattern Overlay -->
    <div class="absolute inset-0 bg-grid-pattern"></div>

    <!-- Floating Elements with Error Theme -->
    <div
      class="absolute top-20 left-10 w-20 h-20 bg-destructive/10 rounded-full blur-xl animate-pulse"
    >
    </div>
    <div
      class="absolute bottom-20 right-10 w-32 h-32 bg-destructive/5 rounded-full blur-xl animate-pulse delay-1000"
    >
    </div>
    <div
      class="absolute top-1/2 left-1/4 w-16 h-16 bg-destructive/5 rounded-full blur-lg animate-bounce delay-500"
    >
    </div>
    <div
      class="absolute top-1/3 right-1/4 w-12 h-12 bg-destructive/10 rounded-full blur-md animate-pulse delay-700"
    >
    </div>

    <div class="relative container mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Error Code -->
      <div class="mb-8">
        <h1 class="text-8xl sm:text-9xl lg:text-[12rem] font-bold leading-none">
          <span
            class="bg-gradient-to-r from-destructive via-primary to-destructive bg-clip-text text-transparent animate-gradient bg-[length:200%_200%]"
          >
            500
          </span>
        </h1>
      </div>

      <!-- Error Icon -->
      <div class="mb-8">
        <div
          class="w-24 h-24 mx-auto mb-6 bg-gradient-to-br from-destructive/20 to-primary/20 rounded-full flex items-center justify-center backdrop-blur-sm border border-destructive/20 animate-pulse"
        >
          <svg
            class="w-12 h-12 text-destructive"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"
            ></path>
          </svg>
        </div>
      </div>

      <!-- Error Message -->
      <h2
        class="text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground mb-6"
      >
        Something Went Wrong
      </h2>

      <p
        class="text-lg sm:text-xl text-muted-foreground mb-8 max-w-2xl mx-auto leading-relaxed"
      >
        Our servers are experiencing some technical difficulties. Don't worry,
        our team has been notified and we're working to fix this issue.
      </p>

      <!-- Status Information -->
      <div class="mb-12 max-w-md mx-auto">
        <div
          class="bg-card/30 backdrop-blur-sm border border-destructive/20 rounded-xl p-6"
        >
          <div class="flex items-center justify-center mb-4">
            <div class="w-3 h-3 bg-destructive rounded-full animate-ping mr-3">
            </div>
            <span class="text-sm font-medium text-destructive"
              >System Status</span
            >
          </div>
          <div class="space-y-2 text-sm">
            <div class="flex justify-between items-center">
              <span class="text-muted-foreground">Database</span>
              <span class="text-destructive">Investigating</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-muted-foreground">API Services</span>
              <span class="text-destructive">Degraded</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-muted-foreground">CDN</span>
              <span class="text-accent">Operational</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div
        class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-16"
      >
        <button
          onclick="window.location.reload()"
          class="inline-flex items-center px-8 py-4 bg-primary text-primary-foreground font-medium rounded-lg hover:scale-105 transition-all duration-200 shadow-lg hover:shadow-primary/25 hover:shadow-xl"
        >
          <svg
            class="mr-2 w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
            ></path>
          </svg>
          Try Again
        </button>

        <a
          href="/"
          class="inline-flex items-center px-8 py-4 border border-border bg-card/50 text-foreground font-medium rounded-lg hover:scale-105 transition-all duration-200 backdrop-blur-sm hover:bg-card/80"
        >
          <svg
            class="mr-2 w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
            ></path>
          </svg>
          Go Home
        </a>

        <a
          href="/contact"
          class="inline-flex items-center px-8 py-4 border border-border bg-card/50 text-foreground font-medium rounded-lg hover:scale-105 transition-all duration-200 backdrop-blur-sm hover:bg-card/80"
        >
          <svg
            class="mr-2 w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Report Issue
        </a>
      </div>

      <!-- Error Details (for developers) -->
      <div class="max-w-2xl mx-auto">
        <details
          class="bg-card/20 backdrop-blur-sm border border-border/30 rounded-xl overflow-hidden"
        >
          <summary
            class="px-6 py-4 cursor-pointer hover:bg-card/30 transition-colors text-left"
          >
            <div class="flex items-center justify-between">
              <span class="font-medium text-foreground">Technical Details</span>
              <svg
                class="w-4 h-4 text-muted-foreground transform transition-transform"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </div>
          </summary>
          <div class="px-6 pb-6 pt-2">
            <div class="bg-muted/20 rounded-lg p-4 font-mono text-sm text-left">
              <div class="text-muted-foreground mb-2">
                Error ID: <span class="text-foreground">ERR_500_2024_001</span>
              </div>
              <div class="text-muted-foreground mb-2">
                Timestamp: <span class="text-foreground" id="error-timestamp"
                ></span>
              </div>
              <div class="text-muted-foreground mb-2">
                Server: <span class="text-foreground">web-01.cluster.local</span
                >
              </div>
              <div class="text-muted-foreground">
                User Agent: <span
                  class="text-foreground text-xs break-all"
                  id="user-agent"></span>
              </div>
            </div>
            <p class="text-xs text-muted-foreground mt-4">
              If you continue to experience issues, please include this
              information when contacting support.
            </p>
          </div>
        </details>
      </div>

      <!-- Helpful Tips -->
      <div class="max-w-lg mx-auto mt-12">
        <div
          class="bg-card/30 backdrop-blur-sm border border-border/30 rounded-xl p-6"
        >
          <div class="flex items-center justify-center mb-3">
            <div
              class="w-8 h-8 bg-accent/20 rounded-full flex items-center justify-center mr-3"
            >
              <svg
                class="w-4 h-4 text-accent"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"
                ></path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-foreground">Quick Tips</h3>
          </div>
          <ul class="text-muted-foreground text-sm space-y-2 text-left">
            <li class="flex items-start">
              <span class="text-accent mr-2">•</span>
              Try refreshing the page in a few minutes
            </li>
            <li class="flex items-start">
              <span class="text-accent mr-2">•</span>
              Check if the issue persists in an incognito window
            </li>
            <li class="flex items-start">
              <span class="text-accent mr-2">•</span>
              Clear your browser cache and cookies
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Add timestamp and user agent info
  document.addEventListener("DOMContentLoaded", function () {
    const timestampEl = document.getElementById("error-timestamp");
    const userAgentEl = document.getElementById("user-agent");

    if (timestampEl) {
      timestampEl.textContent = new Date().toISOString();
    }

    if (userAgentEl) {
      userAgentEl.textContent = navigator.userAgent;
    }

    // Auto-retry functionality
    let retryCount = 0;
    const maxRetries = 3;

    function autoRetry() {
      if (retryCount < maxRetries) {
        retryCount++;
        setTimeout(() => {
          console.log(`Auto-retry attempt ${retryCount}/${maxRetries}`);
          // You could implement actual retry logic here
        }, 30000 * retryCount); // Exponential backoff
      }
    }

    // Uncomment to enable auto-retry
    // autoRetry();
  });
</script>

<style>
  @keyframes gradient {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  .animate-gradient {
    animation: gradient 3s ease infinite;
  }

  details[open] summary svg {
    transform: rotate(180deg);
  }
</style>
