---
export const prerender = false;
import Layout from "@layouts/Layout.astro";

const { cookies, redirect } = Astro;

const accessToken = cookies.get("sb-access-token");
const refreshToken = cookies.get("sb-refresh-token");

if (accessToken && refreshToken) {
  return redirect("/dashboard");
}

// Get error message from URL params if any
const url = new URL(Astro.request.url);
const error = url.searchParams.get("error");

// Security: Basic bot detection
const userAgent = Astro.request.headers.get("user-agent") || "";
const isBot = /bot|crawler|spider|crawling/i.test(userAgent);

if (isBot) {
  return redirect("/404");
}
---

<Layout title="Access Portal" robots="noindex, nofollow, noarchive, nosnippet">
  <div class="w-full max-w-md mx-auto">
    <!-- Header -->
    <div class="text-center mb-12">
      <div
        class="inline-flex items-center px-4 py-2 rounded-full border border-slate-800 text-purple-400 text-sm font-medium mb-8"
      >
        <div class="w-2 h-2 bg-purple-400 rounded-full mr-2 animate-pulse">
        </div>
        secure access
      </div>

      <h1 class="text-2xl sm:text-3xl font-bold mb-4">
        <span class="text-cyan-400">admin</span> portal
      </h1>

      <p class="text-slate-400 text-sm">authorized personnel only</p>
    </div>

    <!-- Error Message -->
    {
      error && (
        <div class="mb-8 p-4 rounded-lg border border-red-800 bg-red-950/50 text-red-300 text-sm">
          <div class="flex items-center">
            <div class="w-2 h-2 bg-red-400 rounded-full mr-3" />
            access denied — invalid credentials
          </div>
        </div>
      )
    }

    <!-- Login Form -->
    <div class="border border-slate-800 rounded-lg p-8 bg-slate-950/80">
      <form
        action="/api/auth/login"
        method="post"
        data-astro-prefetch
        class="space-y-6"
      >
        <!-- Email Field -->
        <div class="space-y-3">
          <label
            for="email"
            class="block text-sm font-medium text-slate-100 uppercase tracking-wide"
          >
            Email Address
          </label>
          <input
            type="email"
            name="email"
            id="email"
            required
            autocomplete="email"
            class="w-full px-4 py-3 bg-slate-900 border border-slate-700 rounded-lg focus:ring-2 focus:ring-cyan-400 focus:border-cyan-400 transition-all text-slate-100 placeholder-slate-500 font-mono"
            placeholder="admin@domain.com"
          />
        </div>

        <!-- Password Field -->
        <div class="space-y-3">
          <label
            for="password"
            class="block text-sm font-medium text-slate-100 uppercase tracking-wide"
          >
            Access Code
          </label>
          <input
            type="password"
            name="password"
            id="password"
            required
            autocomplete="current-password"
            class="w-full px-4 py-3 bg-slate-900 border border-slate-700 rounded-lg focus:ring-2 focus:ring-cyan-400 focus:border-cyan-400 transition-all text-slate-100 placeholder-slate-500 font-mono"
            placeholder="••••••••"
          />
        </div>

        <!-- Hidden honeypot field to catch bots -->
        <input
          type="text"
          name="website"
          style="display: none;"
          tabindex="-1"
          autocomplete="off"
        />

        <!-- Submit Button -->
        <button
          type="submit"
          class="w-full bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-medium py-3 px-6 rounded-lg transition-all duration-200 hover:shadow-lg hover:shadow-cyan-400/25 font-mono"
        >
          authenticate →
        </button>
      </form>

      <!-- Security Notice -->
      <div class="mt-8 pt-6 border-t border-slate-800">
        <div
          class="flex items-center justify-center text-xs text-slate-500 font-mono"
        >
          <div class="w-2 h-2 bg-purple-400 rounded-full mr-3"></div>
          all access attempts monitored
        </div>
      </div>
    </div>

    <!-- Return Link -->
    <div class="text-center mt-12">
      <a
        href="/"
        class="text-slate-400 hover:text-cyan-400 transition-colors text-sm"
      >
        ← back to site
      </a>
    </div>
  </div>
</Layout>

<style>
  @keyframes gradient {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  .animate-gradient {
    animation: gradient 3s ease infinite;
  }
</style>
