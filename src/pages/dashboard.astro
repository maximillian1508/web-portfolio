---
export const prerender = false;
import Layout from "@layouts/Layout.astro";
import { supabase } from "@services/supabase";

const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

if (!accessToken || !refreshToken) {
  return Astro.redirect("/login");
}

let session;
try {
  session = await supabase.auth.setSession({
    refresh_token: refreshToken.value,
    access_token: accessToken.value,
  });

  if (session.error) {
    Astro.cookies.delete("sb-access-token", {
      path: "/",
    });
    Astro.cookies.delete("sb-refresh-token", {
      path: "/",
    });
    return Astro.redirect("/login");
  }
} catch (error) {
  console.log(error);
  Astro.cookies.delete("sb-access-token", {
    path: "/",
  });
  Astro.cookies.delete("sb-refresh-token", {
    path: "/",
  });
  return Astro.redirect("/login");
}

const email = session.data.user?.email;
const user = session.data.user;

// Get current date and time
const now = new Date();
const timeString = now.toLocaleTimeString("en-US", {
  hour: "2-digit",
  minute: "2-digit",
  hour12: true,
});
const dateString = now.toLocaleDateString("en-US", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
});

// Fetch languages directly from Supabase
const { data: languages, error: languagesError } = await supabase
  .from("languages")
  .select("*")
  .eq("is_active", true)
  .order("sort_order", { ascending: true });

if (languagesError) {
  console.error("Error fetching languages:", languagesError);
}

// Fetch all posts directly from Supabase
const { data: allPosts, error: postsError } = await supabase
  .from("posts")
  .select("*")
  .order("created_at", { ascending: false });

if (postsError) {
  console.error("Error fetching posts:", postsError);
}

// For each post, fetch complete details with all translations
const postsWithTranslations = await Promise.all(
  (allPosts || []).map(async (post) => {
    const { data: translationsData, error: translationsError } = await supabase
      .from("post_translations")
      .select(
        `
        *,
        language:languages(*)
      `
      )
      .eq("post_id", post.id)
      .order("created_at", { ascending: true });

    if (translationsError) {
      console.error(
        `Error fetching translations for post ${post.id}:`,
        translationsError
      );
      return post;
    }

    return {
      ...post,
      translations: (translationsData || []).map((t: any) => ({
        id: t.id,
        post_id: t.post_id,
        language_id: t.language_id,
        slug: t.slug,
        title: t.title,
        description: t.description,
        content: t.content,
        is_published: t.is_published,
        created_at: t.created_at,
        updated_at: t.updated_at,
        language: t.language,
      })),
    };
  })
);

// Count published and draft posts
const publishedCount =
  postsWithTranslations?.filter((p) => p.is_published).length || 0;
const draftCount =
  postsWithTranslations?.filter((p) => !p.is_published).length || 0;
---

<Layout title="Admin Dashboard" robots="noindex, nofollow" lang="en">
  <!-- Header -->
  <div class="pb-12">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between">
      <div>
        <h1 class="text-2xl sm:text-3xl font-bold mb-4">
          <span class="text-cyan-400">admin</span> dashboard
        </h1>
        <p class="text-slate-300 text-sm">
          {dateString} • {timeString}
        </p>
      </div>

      <!-- User Info & Logout -->
      <div class="flex items-center space-x-4 mt-6 lg:mt-0">
        <div class="border border-slate-800 rounded-lg p-3">
          <div class="flex items-center space-x-3">
            <div
              class="w-8 h-8 bg-cyan-400 rounded-full flex items-center justify-center"
            >
              <span class="text-slate-950 font-mono font-bold text-sm">ML</span>
            </div>
            <div>
              <p class="text-sm font-medium text-slate-100">Admin</p>
              <p class="text-xs text-slate-400">{email}</p>
            </div>
          </div>
        </div>

        <form action="/api/auth/logout" method="get">
          <button
            type="submit"
            class="text-slate-400 hover:text-purple-400 transition-colors text-sm"
          >
            sign out →
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Stats Grid -->
  <section class="py-12 border-t border-slate-800">
    <h2 class="text-xl font-bold mb-8">
      <span class="text-purple-400">System</span> Metrics
    </h2>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <div>
        <div class="text-3xl font-bold text-cyan-400 mb-2">
          {publishedCount}
        </div>
        <div class="text-slate-400 text-sm uppercase tracking-wide">
          Published Posts
        </div>
        <div class="text-xs text-slate-500 mt-1">{draftCount} drafts</div>
      </div>
      <div>
        <div class="text-3xl font-bold text-purple-400 mb-2">2,847</div>
        <div class="text-slate-400 text-sm uppercase tracking-wide">
          Portfolio Views
        </div>
        <div class="text-xs text-slate-500 mt-1">+12% this month</div>
      </div>
      <div>
        <div class="text-3xl font-bold text-cyan-400 mb-2">8</div>
        <div class="text-slate-400 text-sm uppercase tracking-wide">
          Active Projects
        </div>
        <div class="text-xs text-slate-500 mt-1">2 completed</div>
      </div>
      <div>
        <div class="text-3xl font-bold text-purple-400 mb-2">99.9%</div>
        <div class="text-slate-400 text-sm uppercase tracking-wide">
          System Uptime
        </div>
        <div class="text-xs text-slate-500 mt-1">
          <span class="text-cyan-400">•</span> online
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Actions -->
  <section class="py-12 border-t border-slate-800">
    <h2 class="text-xl font-bold mb-8">
      <span class="text-cyan-400">Quick</span> Actions
    </h2>

    <div class="space-y-4">
      <div class="grid md:grid-cols-4 gap-4 items-start">
        <h3 class="text-base font-semibold text-purple-400">Blog</h3>
        <div class="md:col-span-3 space-y-2">
          <a
            href="/dashboard/editor"
            class="block text-slate-300 hover:text-cyan-400 transition-colors text-sm"
          >
            create new post →
          </a>
          <a
            href="/blog"
            class="block text-slate-300 hover:text-cyan-400 transition-colors text-sm"
          >
            view blog →
          </a>
        </div>
      </div>
      <div
        class="grid md:grid-cols-4 gap-4 items-start border-t border-slate-800 pt-4"
      >
        <h3 class="text-base font-semibold text-purple-400">Content</h3>
        <div class="md:col-span-3 space-y-2">
          <a
            href="/projects"
            class="block text-slate-300 hover:text-cyan-400 transition-colors text-sm"
          >
            manage projects →
          </a>
          <a
            href="/about"
            class="block text-slate-300 hover:text-cyan-400 transition-colors text-sm"
          >
            update about page →
          </a>
          <a
            href="/contact"
            class="block text-slate-300 hover:text-cyan-400 transition-colors text-sm"
          >
            edit contact info →
          </a>
        </div>
      </div>
      <div
        class="grid md:grid-cols-4 gap-4 items-start border-t border-slate-800 pt-4"
      >
        <h3 class="text-base font-semibold text-purple-400">System</h3>
        <div class="md:col-span-3 space-y-2">
          <button
            onclick="window.open('https://supabase.com/dashboard', '_blank')"
            class="block text-slate-300 hover:text-cyan-400 transition-colors text-sm text-left"
          >
            supabase dashboard →
          </button>
          <a
            href="/"
            class="block text-slate-300 hover:text-cyan-400 transition-colors text-sm"
          >
            view public site →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Blog Posts Management -->
  <section class="py-12 border-t border-slate-800">
    <h2 class="text-xl font-bold mb-8">
      <span class="text-cyan-400">Blog</span> Posts
    </h2>

    {
      postsWithTranslations && postsWithTranslations.length > 0 ? (
        <div class="space-y-4">
          {postsWithTranslations.map((post, index) => {
            // Get the first translation for the title (fallback)
            const firstTranslation = post.translations?.[0];
            const hasMultipleTranslations = post.translations?.length > 1;

            return (
              <div
                class={`${index > 0 ? "border-t border-slate-800 pt-4" : ""}`}
              >
                <div class="grid md:grid-cols-6 gap-4 items-start">
                  <div class="md:col-span-3">
                    <div class="flex items-center gap-3 mb-2">
                      <div
                        class={`w-2 h-2 rounded-full ${post.is_published ? "bg-cyan-400" : "bg-slate-600"}`}
                      />
                      <div>
                        <div class="text-slate-200 text-sm font-medium">
                          {firstTranslation?.title || "Untitled Post"}
                        </div>
                        <div class="text-xs text-slate-500 mt-0.5">
                          {new Date(post.updated_at).toLocaleDateString()}
                        </div>
                      </div>
                    </div>

                    {/* Translation indicators */}
                    <div class="flex items-center gap-2 ml-5">
                      <span class="text-xs text-slate-500">Translations:</span>
                      {(languages || []).map((lang) => {
                        const translation = post.translations?.find(
                          (t: any) => t.language.code === lang.code
                        );
                        return (
                          <span
                            class={`inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs ${
                              translation
                                ? translation.is_published
                                  ? "bg-cyan-400/10 text-cyan-400"
                                  : "bg-purple-400/10 text-purple-400"
                                : "bg-slate-800 text-slate-600"
                            }`}
                            title={
                              translation
                                ? translation.is_published
                                  ? "Published"
                                  : "Draft"
                                : "Not created"
                            }
                          >
                            {lang.code.toUpperCase()}
                            {translation && (
                              <span class="text-[10px]">
                                {translation.is_published ? "✓" : "•"}
                              </span>
                            )}
                          </span>
                        );
                      })}
                    </div>
                  </div>

                  <div class="md:col-span-1">
                    <span
                      class={`inline-block px-2 py-0.5 rounded text-xs ${
                        post.is_published
                          ? "bg-cyan-400/10 text-cyan-400"
                          : "bg-slate-700 text-slate-400"
                      }`}
                    >
                      {post.is_published ? "published" : "draft"}
                    </span>
                  </div>

                  <div class="md:col-span-2 flex items-center gap-3">
                    <a
                      href={`/dashboard/editor?postId=${post.id}`}
                      class="text-slate-300 hover:text-purple-400 transition-colors text-sm"
                    >
                      edit →
                    </a>
                    {post.is_published && post.translations?.length > 0 && (
                      <div class="flex gap-2">
                        {post.translations
                          .filter((t: any) => t.is_published)
                          .map((translation: any) => (
                            <a
                              href={
                                translation.language.code === "en"
                                  ? `/blog/${translation.slug}`
                                  : `/${translation.language.code}/blog/${translation.slug}`
                              }
                              target="_blank"
                              class="text-slate-300 hover:text-cyan-400 transition-colors text-xs"
                              title={`View ${translation.language.name} version`}
                            >
                              view ({translation.language.code}) →
                            </a>
                          ))}
                      </div>
                    )}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      ) : (
        <div class="text-center py-8">
          <p class="text-slate-400 text-sm mb-4">No blog posts yet</p>
          <a
            href="/dashboard/editor"
            class="inline-block text-cyan-400 hover:text-purple-400 transition-colors text-sm"
          >
            create your first post →
          </a>
        </div>
      )
    }
  </section>

  <!-- Recent Activity -->
  <section class="py-12 border-t border-slate-800">
    <h2 class="text-xl font-bold mb-8">
      <span class="text-purple-400">Recent</span> Activity
    </h2>

    <div class="space-y-4">
      <div class="grid md:grid-cols-4 gap-4 items-start">
        <div class="text-xs text-slate-500 font-mono">just now</div>
        <div class="md:col-span-3">
          <div class="flex items-center space-x-3">
            <div class="w-2 h-2 bg-cyan-400 rounded-full"></div>
            <span class="text-slate-300 text-sm">dashboard accessed</span>
          </div>
        </div>
      </div>
      <div
        class="grid md:grid-cols-4 gap-4 items-start border-t border-slate-800 pt-4"
      >
        <div class="text-xs text-slate-500 font-mono">2h ago</div>
        <div class="md:col-span-3">
          <div class="flex items-center space-x-3">
            <div class="w-2 h-2 bg-purple-400 rounded-full"></div>
            <span class="text-slate-300 text-sm">portfolio content updated</span
            >
          </div>
        </div>
      </div>
      <div
        class="grid md:grid-cols-4 gap-4 items-start border-t border-slate-800 pt-4"
      >
        <div class="text-xs text-slate-500 font-mono">1d ago</div>
        <div class="md:col-span-3">
          <div class="flex items-center space-x-3">
            <div class="w-2 h-2 bg-cyan-400 rounded-full"></div>
            <span class="text-slate-300 text-sm"
              >new contact inquiry received</span
            >
          </div>
        </div>
      </div>
      <div
        class="grid md:grid-cols-4 gap-4 items-start border-t border-slate-800 pt-4"
      >
        <div class="text-xs text-slate-500 font-mono">3d ago</div>
        <div class="md:col-span-3">
          <div class="flex items-center space-x-3">
            <div class="w-2 h-2 bg-purple-400 rounded-full"></div>
            <span class="text-slate-300 text-sm"
              >system performance optimized</span
            >
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  @keyframes gradient {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  .animate-gradient {
    animation: gradient 3s ease infinite;
  }
</style>
