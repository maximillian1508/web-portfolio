---
import Layout from "@layouts/Layout.astro";
import PageNavigation from "@components/PageNavigation.astro";
import { useTranslations, useTranslatedPath } from "@i18n/utils";

// Define all language routes
export function getStaticPaths() {
  return [
    // English: /projects
    {
      params: { projects: "projects" },
      props: { lang: "en" },
    },
    // Indonesian: /id/proyek (translated route!)
    {
      params: { projects: "id/proyek" },
      props: { lang: "id" },
    },
  ];
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Extended projects data with more detail
const projects = [
  {
    title: t("projects:easyrent.title"),
    subtitle: t("projects:easyrent.subtitle"),
    description: t("projects:easyrent.description"),
    tech: ["React.js", "Express.js", "MongoDB", "Docker", "Stripe"],
    metrics: undefined,
    testimonial: undefined,
    githubUrl: "https://github.com/maximillian1508/easyrent",
    liveUrl: "https://easyrent.maximillianleonard.dev",
    year: t("projects:easyrent.year"),
    status: t("projects:production")
  },
];
---

<Layout title={t("projects:meta.title")} description={t("projects:meta.description")} lang={lang}>
    <!-- Projects Header -->
    <section class="pb-12">
      <div class="max-w-4xl">
        <h1 class="text-h1 font-bold mb-6">
          <span class="text-cyan-400">{t("projects:title")}</span> {t("projects:titleSecond")}
        </h1>
        <p class="text-h4 md:text-lg text-slate-300 leading-relaxed font-light">
          {t("projects:subtitle")}
        </p>
      </div>
    </section>

    <!-- Projects Grid -->
    <section>
      <div class="space-y-12">
        {projects.map((project, index) => (
          <article class={`${index < projects.length - 1 ? 'border-b border-slate-800 pb-12' : ''} `}>
            <!-- Project Header -->
            <div class="mb-6">
              <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-4">
                  <h2 class="text-xl font-bold text-white">{project.title}</h2>
                  <span class="text-xs text-slate-400 bg-slate-800 px-2 py-1 rounded">
                    {project.year}
                  </span>
                  <span class={`text-xs px-2 py-1 rounded ${
                    project.status === 'Production'
                      ? 'text-cyan-400 bg-cyan-400/10'
                      : 'text-purple-400 bg-purple-400/10'
                  }`}>
                    {project.status}
                  </span>
                </div>
                <div class="flex gap-3">
                  <a
                    href={project.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-slate-400 hover:text-cyan-400 transition-colors duration-200 text-sm"
                  >
                    {t("common:github")}
                  </a>
                  <a
                    href={project.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-slate-400 hover:text-purple-400 transition-colors duration-200 text-sm"
                  >
                    {t("common:liveSite")}
                  </a>
                </div>
              </div>
              <h3 class="text-lg text-purple-400 font-semibold mb-4">{project.subtitle}</h3>
            </div>

            <!-- Project Content -->
            <div class="grid md:grid-cols-3 gap-8 mb-6">
              <div class="md:col-span-2">
                <p class="text-slate-300 text-sm leading-relaxed mb-6">{project.description}</p>

                <!-- Tech Stack -->
                <div class="mb-6">
                  <h4 class="text-sm font-semibold text-slate-400 mb-3 uppercase tracking-wide">{t("projects:technologyStack")}</h4>
                  <div class="flex flex-wrap gap-2">
                    {project.tech.map((tech) => (
                      <span class="text-xs text-slate-300 bg-slate-800 px-3 py-1 rounded-full">
                        {tech}
                      </span>
                    ))}
                  </div>
                </div>
              </div>

              {
                project.metrics && (
                  <div class="md:col-span-1">
                    <!-- Metrics -->
                    <div class="mb-6">
                      <h4 class="text-sm font-semibold text-slate-400 mb-3 uppercase tracking-wide">{t("projects:keyMetrics")}</h4>
                      <p class="text-cyan-400 text-sm">{project.metrics}</p>
                    </div>
                  </div>
                )
              }
            </div>

            <!-- Testimonial -->
            {
              project.testimonial && (
                <blockquote class="border-l-2 border-slate-700 pl-6">
                  <p class="text-slate-400 italic text-sm leading-relaxed">"{project.testimonial}"</p>
                  <footer class="mt-2 text-slate-500 text-sm">— {t("common:clientTestimonial")}</footer>
                </blockquote>
              )
            }
          </article>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="py-12 border-t border-slate-800">
      <div class="text-center">
        <p class="text-slate-300 text-sm mb-6">{t("projects:cta.interested")}</p>
        <a
          href={translatePath("/contact")}
          class="text-cyan-400 hover:text-cyan-300 transition-colors text-sm"
        >
          {t("projects:cta.discuss")}
        </a>
      </div>
    </section>
    <PageNavigation lang={lang} />
</Layout>
