---
import Layout from "@layouts/Layout.astro";
import PageNavigation from "@components/PageNavigation.astro";
import { useTranslations } from "@i18n/utils";

// Define all language routes
export function getStaticPaths() {
  return [
    // English: /about
    {
      params: { about: "about" },
      props: { lang: "en" },
    },
    // Indonesian: /id/tentang (translated route!)
    {
      params: { about: "id/tentang" },
      props: { lang: "id" },
    },
  ];
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// About sections data
const aboutSections = [
  {
    title: t("about:sections.background.title"),
    content: t("about:sections.background.content"),
  },
  {
    title: t("about:sections.expertise.title"),
    content: t("about:sections.expertise.content"),
  },
  {
    title: t("about:sections.approach.title"),
    content: t("about:sections.approach.content"),
  },
];
---

<Layout
  title={t("about:meta.title")}
  description={t("about:meta.description")}
  lang={lang}
>
  <!-- About Header -->
  <section class="pb-0 md:pb-12">
    <div class="max-w-4xl">
      <h1 class="text-h1 font-bold mb-6">
        <span class="text-cyan-400">{t("about:title")}</span>
        {t("about:titleSecond")}
      </h1>
      <p class="text-h4 md:text-lg text-slate-300 leading-relaxed font-light">
        {t("about:subtitle")}
      </p>
    </div>
  </section>

  <!-- Main Content -->
  <!-- The Beginning -->
  <section class="py-12">
    <div>
      <h2 class="text-h2 font-bold mb-8">
        <span class="text-cyan-400">The</span> Beginning
      </h2>
      <p class="text-slate-300 text-sm leading-relaxed">
        {t("about:subtitle")}
      </p>
    </div>
  </section>

  <!-- What I'm Working On -->
  <section class="py-12 border-t border-slate-800">
    <div>
      <h2 class="text-h2 font-bold mb-8">
        <span class="text-purple-400">What I'm</span> Working On
      </h2>
      <p class="text-slate-300 text-sm leading-relaxed mb-6">
        Currently specializing in full-stack development with a focus on modern
        web technologies. I'm particularly interested in performance
        optimization, developer tooling, and creating seamless user experiences
        across different platforms.
      </p>
      <div class="bg-slate-900/30 border-l-4 border-cyan-400/50 pl-6 py-4">
        <div class="text-slate-400 text-xs uppercase tracking-wider mb-3">
          Current Interests
        </div>
        <div class="text-slate-300 space-y-2">
          <div class="flex items-center gap-2">
            <div class="w-1 h-1 bg-cyan-400 rounded-full"></div>
            <span class="text-sm"
              >Edge computing & serverless architectures</span
            >
          </div>
          <div class="flex items-center gap-2">
            <div class="w-1 h-1 bg-purple-400 rounded-full"></div>
            <span class="text-sm"
              >Real-time applications & WebSocket implementations</span
            >
          </div>
          <div class="flex items-center gap-2">
            <div class="w-1 h-1 bg-cyan-400 rounded-full"></div>
            <span class="text-sm"
              >Database optimization & query performance</span
            >
          </div>
          <div class="flex items-center gap-2">
            <div class="w-1 h-1 bg-purple-400 rounded-full"></div>
            <span class="text-sm">AI/ML integration in web applications</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About Content -->
  <section class="py-12 border-t border-slate-800">
    <div class="space-y-8">
      {
        aboutSections.map((section, index) => (
          <div
            class={`${index < aboutSections.length - 1 ? "border-b border-slate-800" : ""} pb-8`}
          >
            <div class="grid md:grid-cols-4 gap-8">
              <div class="md:col-span-1">
                <h2 class="text-lg font-bold text-purple-400">
                  {section.title}
                </h2>
              </div>
              <div class="md:col-span-3">
                <p class="text-slate-300 text-sm leading-relaxed">
                  {section.content}
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Beyond the Screen -->
  <section class="py-12 border-t border-slate-800">
    <div>
      <h2 class="text-h2 font-bold mb-8">
        <span class="text-purple-400">Beyond the</span> Screen
      </h2>
      <p class="text-slate-300 text-sm leading-relaxed mb-4">
        When not coding, I enjoy exploring the intersection of technology and
        creativity. I'm fascinated by digital art, generative design, and how
        emerging technologies can enhance human expression.
      </p>
      <p class="text-slate-300 text-sm leading-relaxed">
        I also contribute to open-source projects, write technical articles, and
        mentor aspiring developers. Giving back to the community that has taught
        me so much is incredibly rewarding.
      </p>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="py-12 border-t border-slate-800">
    <div>
      <h2 class="text-h2 font-bold mb-8">
        <span class="text-cyan-400">Let's</span> Connect
      </h2>
      <p class="text-slate-300 text-sm mb-6">{t("about:cta.interested")}</p>
      <a
        href="mailto:hello@maximillianleonard.dev"
        class="text-cyan-400 hover:text-cyan-300 transition-colors text-sm"
      >
        {t("about:cta.discuss")}
      </a>
    </div>
  </section>
  <PageNavigation lang={lang} />
</Layout>
