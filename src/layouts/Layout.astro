---
import "../styles/global.css";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import FloatingSettings from "@components/FloatingSettings.astro";
import { useTranslations, getAlternateUrls } from "@i18n/utils";
import { languages } from "@i18n/ui";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  lang: string;
  robots?: string;
  alternateUrls?: Record<string, string>;
}

const { title, description, lang, robots, alternateUrls: customAlternateUrls } = Astro.props;
const t = useTranslations(lang);
const alternateUrls = customAlternateUrls || getAlternateUrls(Astro.url, Object.keys(languages));
---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- Basic Meta Tags -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <title>
      {title || t("meta:title")}
    </title>
    <meta name="description" content={description || t("meta:description")} />
    <meta
      name="keywords"
      content="Maximillian Leonard, Full-Stack Developer, AI Enthusiast, Software Engineer, React, Next.js, TypeScript, Kuala Lumpur, Web Development, Frontend, Backend"
    />
    <meta name="author" content="Maximillian Leonard" />
    <meta name="robots" content={robots || "index, follow"} />
    <meta name="language" content={lang === "en" ? "English" : "Indonesian"} />
    <meta http-equiv="Content-Language" content={lang} />

    <!-- Favicon and Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#6726a3" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.toString().replace(/\/$/, "")} />
    <meta property="og:title" content={title || t("meta:title")} />
    <meta
      property="og:description"
      content={description || t("meta:description")}
    />
    <meta property="og:image" content="/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "id_ID"} />
    <meta
      property="og:locale:alternate"
      content={lang === "en" ? "id_ID" : "en_US"}
    />
    <meta property="og:site_name" content="Maximillian Leonard Portfolio" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta
      property="twitter:url"
      content={Astro.url.toString().replace(/\/$/, "")}
    />
    <meta property="twitter:title" content={title || t("meta:title")} />
    <meta
      property="twitter:description"
      content={description || t("meta:description")}
    />
    <meta property="twitter:image" content="/og-image.png" />
    <meta name="twitter:creator" content="@maximillianleonard" />

    <!-- Performance and Security -->
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- Canonical and Alternates -->
    <link rel="canonical" href={Astro.url.toString().replace(/\/$/, "")} />
    {
      Object.entries(alternateUrls).map(([lang, url]) => (
        <link rel="alternate" hreflang={lang} href={url} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={alternateUrls.en} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Maximillian Leonard",
        "url": "https://maximillianleonard.dev",
        "jobTitle": "Full-Stack Developer",
        "description": "Full-Stack Developer & AI Enthusiast based in Kuala Lumpur",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Kuala Lumpur",
          "addressCountry": "Malaysia"
        },
        "sameAs": [
          "https://github.com/maximillianleonard",
          "https://linkedin.com/in/maximillianleonard",
          "https://twitter.com/maximillianleonard"
        ]
      }
    </script>
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 antialiased" data-alternate-urls={JSON.stringify(alternateUrls)}>
    <Header lang={lang} />
    <main
      class="flex-1 pt-32 pb-12 max-w-[1280px] mx-auto px-4 md:px-6 lg:px-8"
    >
      <slot />
    </main>
    <Footer lang={lang} />
    <FloatingSettings />
  </body>
</html>
