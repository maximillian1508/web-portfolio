---
import "../styles/global.css";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import FloatingSettings from "@components/FloatingSettings.astro";
import { getLangFromUrl, useTranslations, getAlternateUrls } from "@i18n/utils";

const { title, robots } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const alternateUrls = getAlternateUrls(Astro.url);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Basic Meta Tags -->
    <title>
      {title || t("meta.title")}
    </title>
    <meta name="description" content={t("meta.description")} />
    <meta
      name="keywords"
      content="Maximillian Leonard, Full-Stack Developer, AI Enthusiast, Software Engineer, React, Next.js, TypeScript, Kuala Lumpur, Web Development, Frontend, Backend"
    />
    <meta name="author" content="Maximillian Leonard" />
    <meta name="robots" content={robots || "index, follow"} />
    <meta name="language" content={lang === "en" ? "English" : "Indonesian"} />
    <meta http-equiv="Content-Language" content={lang} />

    <!-- Favicon and Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#6726a3" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title || t("meta.title")} />
    <meta property="og:description" content={t("meta.description")} />
    <meta property="og:image" content="/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "id_ID"} />
    <meta
      property="og:locale:alternate"
      content={lang === "en" ? "id_ID" : "en_US"}
    />
    <meta property="og:site_name" content="Maximillian Leonard Portfolio" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title || t("meta.title")} />
    <meta property="twitter:description" content={t("meta.description")} />
    <meta property="twitter:image" content="/og-image.jpg" />
    <meta name="twitter:creator" content="@maximillianleonard" />

    <!-- Performance and Security -->
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Canonical and Alternates -->
    <link rel="canonical" href={Astro.url.href} />
    <link rel="alternate" hreflang="en" href={alternateUrls.en} />
    <link rel="alternate" hreflang="id" href={alternateUrls.id} />
    <link rel="alternate" hreflang="x-default" href={alternateUrls.default} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Maximillian Leonard",
        "url": "https://maximillianleonard.dev",
        "jobTitle": "Full-Stack Developer",
        "description": "Full-Stack Developer & AI Enthusiast based in Kuala Lumpur",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Kuala Lumpur",
          "addressCountry": "Malaysia"
        },
        "sameAs": [
          "https://github.com/maximillianleonard",
          "https://linkedin.com/in/maximillianleonard",
          "https://twitter.com/maximillianleonard"
        ]
      }
    </script>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 antialiased">
    <Header />
    <main class="flex-1 pt-32 pb-12 max-w-[1280px] mx-auto px-4 md:px-6 lg:px-">
      <slot />
    </main>
    <Footer />
    <FloatingSettings />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
